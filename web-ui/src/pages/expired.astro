---
/* Shown where an invitation link has been withdrawn by the couple — the
   personalised /<wedding>/<invitee> or the shared /<wedding>.

   It is deliberately not the 404: that page tells a stranger their link was
   never real, which is the wrong thing to say to someone who was invited and
   whose card has simply been retired. This one closes the door kindly and
   points them back at the couple, without naming anybody. */
import Base from '../layouts/Base.astro';

export const prerender = false;
---
<Base
  title="This invitation has closed"
  description="This invitation link is no longer open. Please contact the couple for an up-to-date link."
>
  <main class="expired">
    <div class="expired__card">
      <div class="expired__seal" aria-hidden="true">
        <svg viewBox="0 0 120 120" role="presentation">
          <circle class="seal__ring" cx="60" cy="60" r="46" />
          <circle class="seal__ring seal__ring--inner" cx="60" cy="60" r="38" />
          <path class="seal__flap" d="M32 48 L60 68 L88 48" />
          <rect class="seal__body" x="32" y="44" width="56" height="36" rx="2" />
          <path class="seal__ribbon" d="M60 80 L60 96" />
        </svg>
      </div>

      <p class="eyebrow">With our thanks</p>
      <h1 class="script">The envelope has been sealed</h1>

      <div class="ornament" aria-hidden="true">✦</div>

      <p class="expired__copy">
        This invitation link has been closed and is no longer taking replies.
        If you were expecting to find your card here, the couple will be glad
        to send you a fresh one.
      </p>

      <p class="expired__meta">
        Already replied? Your reply is safely kept — there is nothing more you
        need to do.
      </p>
    </div>
  </main>
</Base>

<style>
  .expired {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem var(--gutter);
    background: var(--ivory);
  }

  .expired__card {
    max-width: 34rem;
    text-align: center;
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1.5rem, 5vw, 3.5rem);
    border: 1px solid rgba(176, 141, 79, 0.3);
    background: linear-gradient(180deg, var(--ivory) 0%, var(--ivory-deep) 100%);
    animation: rise 1.1s var(--ease-out-expo) both;
  }

  .expired__seal { width: 6.5rem; margin: 0 auto 1.75rem; }
  .expired__seal svg { width: 100%; height: auto; overflow: visible; }
  .seal__ring, .seal__flap, .seal__body, .seal__ribbon {
    fill: none;
    stroke: var(--gold);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .seal__ring { stroke-dasharray: 3 6; opacity: 0.55; }
  .seal__ring--inner { opacity: 0.3; stroke-dasharray: none; }
  /* The flap is drawn shut over the body: the envelope is closed, not empty. */
  .seal__body { fill: rgba(216, 189, 138, 0.14); }
  .seal__ribbon { opacity: 0.45; }

  .expired h1 {
    font-size: clamp(2rem, 6vw, 3.1rem);
    line-height: 1.15;
    margin: 0.4rem 0 0;
  }

  .expired .ornament { margin: 1.6rem 0; font-size: 0.7rem; }

  .expired__copy {
    color: var(--ink-soft);
    max-width: 28em;
    margin: 0 auto;
    line-height: 1.75;
  }

  .expired__meta {
    margin: 2rem 0 0;
    padding-top: 1.4rem;
    border-top: 1px solid rgba(176, 141, 79, 0.25);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    opacity: 0.8;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(1.2rem); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .expired__card { animation: none; }
  }
</style>

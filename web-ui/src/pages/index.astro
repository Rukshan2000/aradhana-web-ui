---
/* The product's front door. `/` has no wedding slug, so there is no invitation
   to render here — it used to fall back to the sample couple, which made the
   product's own address look like one stranger's wedding. This page says what
   the Guest Book is instead, and sends visitors to the two places that are
   real: a finished sample invitation at /demo, and the portal to build one.

   Static, so it never shadows a wedding: the `[wedding]` dynamic route only
   ever sees a slug. */
import Base from '../layouts/Base.astro';
import { portalUrl } from '../lib/portal.js';

export const prerender = false;

const signIn = portalUrl('/login');
const signUp = portalUrl('/register');

const surfaces = [
  {
    n: '01',
    title: 'A page, not a picture',
    body: `Your invitation is a website, not a JPEG in a WhatsApp thread. It opens with a
           sealed envelope, unfolds as the guest scrolls, counts down to the day, and carries
           your story, your photographs, the schedule and the RSVP in one place.`,
  },
  {
    n: '02',
    title: 'One link per household',
    body: `Every family gets its own address. The page greets them by name, knows how many
           seats you have set aside for them, and files their reply against them — so a
           reply is never an anonymous "someone said yes".`,
  },
  {
    n: '03',
    title: 'You always know where you stand',
    body: `A live count of who has opened, who has read to the end, who has replied and how
           many are coming — with dietary notes and messages attached to the right names,
           ready to hand to the caterer.`,
  },
];

const steps = [
  ['Create the wedding', 'Names, date, city, venue. Two minutes, and the page already exists.'],
  ['Fill it with your own', 'Your photos, your story, your schedule — edited in the portal, live on the page instantly. Anything you leave blank stays tasteful.'],
  ['Add your guests', 'One at a time or a household at a time. Each gets a private link and a QR code you can print or send.'],
  ['Watch the replies land', 'Opens, reading depth and RSVPs arrive as they happen. Close a link at any time; the reply history stays.'],
];

/* The fan of phones. Every one of these is a real screenshot of `/demo`,
   captured by scripts/shots.mjs — not a mockup drawn to look like the page.
   `lift` staggers them out of a straight line and `drift` is the parallax
   rate, so they separate as the section passes rather than moving as a slab. */
const screens = [
  { src: '/assets/shots/phone-hero.jpg', label: 'The arrival', note: 'A sealed envelope, their name on it, and the photograph waiting underneath.', lift: 0, drift: '0.14' },
  { src: '/assets/shots/phone-story.jpg', label: 'Your story', note: 'The years told a moment at a time, each one arriving as they scroll.', lift: 44, drift: '0.22' },
  { src: '/assets/shots/phone-gallery.jpg', label: 'The gallery', note: 'The photographs you would have printed, at the size they deserve.', lift: 12, drift: '0.18' },
  { src: '/assets/shots/phone-rsvp.jpg', label: 'The reply', note: 'Two taps and a note. It lands in your list before they lock their phone.', lift: 56, drift: '0.26' },
];

const details = [
  ['Private links, revocable', 'A link sent to a wrong number, or forwarded to someone who is no longer welcome, can be switched off. The guest and their reply stay in your records — only the URL stops working.'],
  ['An open link too', 'One shareable address for the people you cannot list in advance. They name themselves, say how many are coming, and appear in your guest list.'],
  ['A Sri Lankan planner', 'Nekath, poruwa decorator, bridal dresser, hewisi drummers — a full twelve-month checklist and budget, ordered by what actually blocks what. Edit every line.'],
  ['Music, gallery, story', 'A song that fades in when the page opens, a gallery of the two of you, and your story told a moment at a time as the guest scrolls.'],
  ['Works on the phone it was sent to', 'Built for the thumb first. It loads on a weak connection, and it respects a guest who has asked their phone to reduce motion.'],
  ['Nothing to install', 'No app, no account, no sign-in for your guests. They tap the link and they are in.'],
];
---

<Base
  title="Guest Book — wedding invitations that reply back"
  description="A digital wedding invitation with a private link for every household, live RSVPs, and a planner. Build yours in an evening."
>
  <header class="topbar">
    <a class="brand" href="/">
      <img class="brand__mark" src="/assets/logo-mark.png" alt="" width="34" height="34" />
      <span class="brand__name">Guest&nbsp;Book</span>
    </a>
    <nav class="topbar__nav">
      <a href="#what">What it is</a>
      <a href="#see">See it</a>
      <a href="#how">How it works</a>
      <a href="/demo">See one</a>
      <a class="btn btn--ghost" href={signIn}>Sign in</a>
    </nav>
  </header>

  <main>
    <!-- ── Hero ─────────────────────────────────────────────────────── -->
    <section class="lead">
      <div class="lead__inner wrap">
        <p class="eyebrow" data-reveal="down">Kwings Media</p>
        <h1 class="lead__title" data-reveal="up">Your invitation,<br /><em class="script">and everyone who answers it</em></h1>
        <p class="lead__sub" data-reveal="up">
          A wedding invitation that lives at its own address, greets each household by name,
          and tells you who opened it, who read it to the end, and who is coming — while you
          are still deciding on the cake.
        </p>
        <div class="cta" data-reveal="up">
          <a class="btn btn--solid" href={signUp}>Build your invitation</a>
          <a class="btn btn--line" href="/demo">See a finished one</a>
        </div>
        <p class="lead__note" data-reveal="up">
          The sample opens exactly as your guests' would. Nothing to install, nothing to sign up for to look.
        </p>
      </div>
      <div class="lead__glow" aria-hidden="true"></div>

      <!-- The page selling itself: an actual frame of /demo, in a browser
           chrome so it reads as a website rather than a stock photograph. -->
      <figure class="browser" data-reveal="up">
        <div class="browser__bar">
          <span class="browser__dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="browser__url">guestbook.kwingsmedia.com/tharu-sithika/<b>the-fernandos</b></span>
        </div>
        <div class="browser__view" data-curtain data-wipe="up">
          <img src="/assets/shots/desk-hero.jpg" alt="The invitation page open on a desktop browser"
               width="2880" height="1800" loading="eager" decoding="async" />
        </div>
      </figure>
    </section>

    <div class="ornament" aria-hidden="true">✦</div>

    <!-- ── What it is ───────────────────────────────────────────────── -->
    <section class="section" id="what">
      <div class="wrap">
        <p class="eyebrow" data-reveal="down">What it is</p>
        <h2 class="h2" data-reveal="up">Three things a printed card cannot do</h2>
        <div class="surfaces" data-stagger="140">
          {surfaces.map((s, i) => (
            <article class="surface" data-reveal={i % 2 ? 'right' : 'left'}>
              <span class="surface__n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── The fan of screens ───────────────────────── -->
    <section class="section fan-section" id="see">
      <div class="wrap fan-intro">
        <div data-reveal="left">
          <p class="eyebrow">Look at it</p>
          <h2 class="h2">Four screens out of the real thing</h2>
        </div>
        <p class="fan-lead" data-reveal="right">
          Not mockups — these are photographs of the sample invitation, taken from the page
          itself and re-taken whenever it changes. Yours differs only in whose faces are in it.
        </p>
      </div>

      <div class="fan" role="list">
        {screens.map((sc, i) => (
          <figure class="phone" role="listitem" style={`--lift:${sc.lift}px`}
                  data-reveal={i % 2 ? 'right' : 'left'}>
            <span class="phone__drift" data-parallax={sc.drift}>
              <span class="phone__body">
                <span class="phone__notch" aria-hidden="true"></span>
                <span class="phone__screen">
                  <img src={sc.src} alt={`The invitation's ${sc.label.toLowerCase()} screen`}
                       width="800" height="1720" loading="lazy" decoding="async" />
                </span>
              </span>
            </span>
            <figcaption>
              <b>{sc.label}</b>
              <span>{sc.note}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="wrap" style="text-align:center">
        <a class="btn btn--line" href="/demo">Open the whole thing</a>
      </div>
    </section>

    <!-- ── The two links ────────────────────────────────────────────── -->
    <section class="section band">
      <div class="wrap links">
        <div class="links__copy" data-reveal="left">
          <p class="eyebrow">Two kinds of link</p>
          <h2 class="h2">The named ones, and everyone else</h2>
          <p>
            Close family gets a link of their own — their name on the page, their seats already
            counted, their reply attached to them. For the rest, the invitation you post in a
            group chat: whoever opens it writes their own name and joins your list.
          </p>
          <p>
            Either can be switched off the moment you need it to be, without losing a single
            reply that came through it.
          </p>
        </div>
        <div class="links__demo" data-reveal="right">
          <div class="chip">
            <span class="chip__label">Personal</span>
            <code>guestbook.kwingsmedia.com/<b>aradhana-nihal</b>/<b>the-fernandos</b></code>
            <p>“Dear Fernando family — 4 seats held for you.”</p>
          </div>
          <div class="chip">
            <span class="chip__label">Open</span>
            <code>guestbook.kwingsmedia.com/<b>aradhana-nihal</b></code>
            <p>“Tell us your name and how many are coming.”</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── How it works ─────────────────────────────────────────────── -->
    <section class="section" id="how">
      <div class="wrap">
        <p class="eyebrow" data-reveal="down">How it works</p>
        <h2 class="h2" data-reveal="up">Four steps, one evening</h2>
        <ol class="steps" data-stagger="120">
          {steps.map(([title, body], i) => (
            <li data-reveal={i % 2 ? 'right' : 'left'}>
              <span class="steps__n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{title}</h3>
                <p>{body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ── Everything else ──────────────────────────────────────────── -->
    <section class="section band">
      <div class="wrap">
        <p class="eyebrow" data-reveal="down">And the rest of it</p>
        <h2 class="h2" data-reveal="up">Small things that turn out to matter</h2>
        <div class="grid" data-stagger="90">
          {details.map(([title, body], i) => (
            <div class="card" data-reveal={i % 2 ? 'right' : 'left'}>
              <h3>{title}</h3>
              <p>{body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Close ────────────────────────────────────────────────────── -->
    <section class="section close">
      <div class="narrow" style="text-align:center">
        <div class="ornament" aria-hidden="true">✦</div>
        <h2 class="h2" data-reveal="up" style="margin-top:2rem">Send us three things and we can start</h2>
        <p data-reveal="up">
          Both names, the date and place, and one good photograph of the two of you. Everything
          else can follow while the page is already live.
        </p>
        <div class="cta cta--center" data-reveal="up">
          <a class="btn btn--solid" href={signUp}>Start your wedding</a>
          <a class="btn btn--line" href={signIn}>I already have an account</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot__inner">
      <span class="foot__brand">
        <img src="/assets/logo-mark.png" alt="" width="22" height="22" />
        Guest Book — <a href="https://kwingsmedia.com">Kwings Media</a>
      </span>
      <span class="foot__links">
        <a href="/demo">Sample invitation</a>
        <a href={signIn}>Portal</a>
      </span>
    </div>
  </footer>
</Base>

<style>
  /* The invitation's tokens, borrowed. This page is quieter than an
     invitation on purpose: it is the shop window, not the ceremony. */

  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem var(--gutter);
    background: rgba(251, 248, 243, 0.82);
    backdrop-filter: blur(10px);
    border-bottom: var(--rule);
  }
  .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; }
  /* The real mark, shared with the portal's sign-in screen so the two
     surfaces are recognisably the same product. Its gold is where the
     palette's --gold came from, so it sits on the ivory without a border. */
  .brand__mark { width: 34px; height: 34px; object-fit: contain; }
  .brand__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.06em;
  }
  .topbar__nav { display: flex; align-items: center; gap: clamp(0.75rem, 2vw, 1.75rem); }
  .topbar__nav a { text-decoration: none; font-size: 0.85rem; letter-spacing: 0.08em; }
  .topbar__nav a:not(.btn):hover { color: var(--gold); }
  /* Below the fold the section anchors are the first thing to go — the two
     buttons have to survive to the narrowest phone. */
  @media (max-width: 700px) {
    .topbar__nav a[href^="#"] { display: none; }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.6rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    transition: background-color 0.4s var(--ease-out-expo), color 0.4s var(--ease-out-expo),
      border-color 0.4s var(--ease-out-expo);
  }
  .btn--solid { background: var(--ink); color: var(--ivory); }
  .btn--solid:hover { background: var(--gold); }
  .btn--line { border: 1px solid var(--gold); color: var(--gold); }
  .btn--line:hover { background: var(--gold); color: var(--ivory); }
  .btn--ghost { padding: 0.5rem 1.1rem; border: 1px solid rgba(176, 141, 79, 0.5); }
  .btn--ghost:hover { background: var(--gold); color: var(--ivory); border-color: var(--gold); }

  /* ── Hero ─────────────────────────────────────────────────────── */
  .lead {
    position: relative;
    padding: clamp(4.5rem, 14vh, 9rem) var(--gutter) clamp(3rem, 8vh, 6rem);
    text-align: center;
    overflow: hidden;
  }
  .lead__inner { position: relative; z-index: 1; max-width: 900px; }
  .lead__title {
    font-size: clamp(2.6rem, 7vw, 5.4rem);
    margin-bottom: 1.6rem;
  }
  .lead__sub {
    max-width: 44ch;
    margin-inline: auto;
    color: var(--ink-soft);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
  }
  .lead__note { font-size: 0.82rem; color: var(--ink-soft); opacity: 0.8; margin: 0; }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
    margin: 2.2rem 0 1.4rem;
  }
  .cta--center { margin-top: 2rem; }
  /* A soft wash rather than a photograph: the hero of this page is the
     sentence, and a couple's photo here would be someone else's wedding. */
  .lead__glow {
    position: absolute;
    inset: -30% -10% auto -10%;
    height: 120%;
    background:
      radial-gradient(closest-side, rgba(216, 189, 138, 0.28), transparent 70%) 30% 20% / 60% 70% no-repeat,
      radial-gradient(closest-side, rgba(232, 213, 205, 0.35), transparent 70%) 75% 40% / 55% 65% no-repeat;
    pointer-events: none;
  }

  /* ── Browser frame under the hero ─────────────────────────────
     A real screenshot needs a frame, or it reads as a background image.
     The chrome is drawn, not another image, so it stays crisp at any size. */
  .browser {
    position: relative;
    z-index: 1;
    margin: clamp(2.5rem, 6vw, 4.5rem) auto 0;
    max-width: 1000px;
    border: 1px solid rgba(176, 141, 79, 0.35);
    border-radius: 10px;
    overflow: hidden;
    background: var(--ivory);
    box-shadow: 0 40px 90px -40px rgba(34, 29, 23, 0.45);
  }
  .browser__bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.6rem 0.9rem;
    background: var(--ivory-deep);
    border-bottom: 1px solid rgba(176, 141, 79, 0.25);
  }
  .browser__dots { display: flex; gap: 0.4rem; flex: none; }
  .browser__dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(176, 141, 79, 0.4);
  }
  /* The URL is the product's own claim — one address per household — so it is
     real text rather than part of the screenshot, and stays legible when the
     image is compressed. */
  .browser__url {
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .browser__url b { color: var(--gold); font-weight: 400; }
  .browser__view { display: block; aspect-ratio: 16 / 10; }
  .browser__view img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }

  /* ── The fan of phones ────────────────────────────────────────
     Overflow is hidden on the section, not the row: the parallax lifts each
     phone out of its own box, and a clipped column would cut the drift off
     mid-travel. */
  .fan-section { overflow: hidden; }
  /* Heading left, the caveat right — the fan below is wide, and a headline
     alone on a 1180px row leaves a hole where the eye expects the rest. */
  .fan-intro {
    display: grid;
    gap: clamp(1rem, 4vw, 3rem);
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: end;
  }
  .fan-lead { max-width: 46ch; color: var(--ink-soft); margin: 0; }
  @media (max-width: 820px) {
    .fan-intro { grid-template-columns: 1fr; align-items: start; }
  }
  .fan {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2.25rem);
    align-items: start;
    max-width: 1180px;
    margin: clamp(3rem, 7vw, 5rem) auto clamp(2.5rem, 5vw, 4rem);
    padding-inline: var(--gutter);
  }
  /* --lift breaks the straight line; the parallax then pulls them further
     apart as the section passes. */
  .phone { margin: 0; padding-top: var(--lift, 0px); }
  .phone__drift { display: block; will-change: transform; }
  .phone__body {
    display: block;
    position: relative;
    border-radius: 26px;
    padding: 7px;
    background: linear-gradient(160deg, #2c2620, #17130f);
    box-shadow: 0 30px 60px -30px rgba(34, 29, 23, 0.6);
  }
  /* The screen is a window, not a frame the image is fitted into. The shot
     keeps its natural width (`height: auto`) and the window clips whatever
     falls below — `object-fit: cover` cropped the sides instead, which sliced
     the headline off the middle of every screenshot. Four full-length phones
     would also be a wall of image, so the window is deliberately shorter than
     the capture: it reads as a screen the page continues below. */
  .phone__screen {
    display: block;
    aspect-ratio: 400 / 700;
    overflow: hidden;
    border-radius: 20px;
    background: var(--ivory);
  }
  .phone__screen img {
    width: 100%;
    height: auto;
    display: block;
  }
  .phone__notch {
    position: absolute;
    top: 13px;
    left: 50%;
    transform: translateX(-50%);
    width: 30%;
    height: 5px;
    border-radius: 999px;
    background: rgba(251, 248, 243, 0.25);
    z-index: 1;
  }
  .phone figcaption { display: block; margin-top: 1.1rem; }
  .phone figcaption b {
    display: block;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 400;
    margin-bottom: 0.25rem;
  }
  .phone figcaption span { font-size: 0.85rem; color: var(--ink-soft); line-height: 1.6; }

  /* Below the grid's comfortable width the fan becomes a swipeable row —
     four phones squeezed into a phone screen are four thumbnails. The lift is
     dropped here: staggering only reads when the whole row is in view. */
  @media (max-width: 860px) {
    .fan {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 1rem;
      -webkit-overflow-scrolling: touch;
    }
    .phone {
      flex: 0 0 min(62vw, 260px);
      padding-top: 0;
      scroll-snap-align: center;
    }
  }

  .h2 {
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    margin-bottom: 1.6rem;
    max-width: 20ch;
  }
  .band { background: var(--ivory-deep); }

  /* ── What it is ───────────────────────────────────────────────── */
  .surfaces {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    margin-top: 3rem;
  }
  .surface { border-top: var(--rule); padding-top: 1.4rem; }
  .surface__n {
    display: block;
    font-family: var(--font-display);
    color: var(--gold);
    font-size: 0.95rem;
    letter-spacing: 0.3em;
    margin-bottom: 0.9rem;
  }
  .surface h3 { font-size: 1.5rem; margin-bottom: 0.7rem; }
  .surface p { color: var(--ink-soft); margin: 0; }

  /* ── Two links ────────────────────────────────────────────────── */
  .links {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    align-items: center;
  }
  .links__copy p { color: var(--ink-soft); }
  .links__demo { display: grid; gap: 1.25rem; }
  .chip {
    background: var(--ivory);
    border: var(--rule);
    border-radius: 4px;
    padding: 1.25rem 1.4rem;
  }
  .chip__label {
    display: inline-block;
    font-size: 0.65rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.7rem;
  }
  /* The URLs are the point of this block, so they get to overflow their box
     on a narrow screen rather than break the page's own width. */
  .chip code {
    display: block;
    overflow-x: auto;
    font-size: 0.82rem;
    color: var(--ink);
    white-space: nowrap;
  }
  .chip code b { color: var(--gold); font-weight: 400; }
  .chip p {
    margin: 0.8rem 0 0;
    font-style: italic;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--ink-soft);
  }

  /* ── Steps ────────────────────────────────────────────────────── */
  .steps { list-style: none; margin: 3rem 0 0; padding: 0; display: grid; gap: 2rem; }
  .steps li { display: flex; gap: clamp(1rem, 3vw, 2.5rem); align-items: baseline; }
  .steps__n {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    color: var(--gold-light);
    min-width: 2.5ch;
  }
  .steps h3 { font-size: 1.4rem; margin-bottom: 0.4rem; }
  .steps p { color: var(--ink-soft); margin: 0; }

  /* ── Detail grid ──────────────────────────────────────────────── */
  .grid {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    margin-top: 3rem;
  }

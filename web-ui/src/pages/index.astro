---
import Base from '../layouts/Base.astro';
import Envelope from '../components/Envelope.astro';
import Hero from '../components/Hero.astro';
import Invitation from '../components/Invitation.astro';
import Countdown from '../components/Countdown.astro';
import Story from '../components/Story.astro';
import Gallery from '../components/Gallery.astro';
import Details from '../components/Details.astro';
import Rsvp from '../components/Rsvp.astro';
import Footer from '../components/Footer.astro';
import Butterflies from '../components/Butterflies.astro';
import { couple } from '../data/wedding.js';
---
<Base
  title={`${couple.bride} & ${couple.groom} — ${couple.dateLabel}`}
  description={`Join ${couple.bride} and ${couple.groom} in ${couple.city} as they celebrate their wedding. Ceremony details, schedule, gallery, and RSVP.`}
>
  <Envelope />
  <Hero />
  <Invitation />
  <Countdown />
  <Story />
  <Gallery />
  <Details />
  <Rsvp />
  <Footer />
  <Butterflies />
</Base>

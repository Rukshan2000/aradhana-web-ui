---
import { couple as defaultCouple, details as defaultDetails, schedule as defaultSchedule, venuePhoto as defaultVenuePhoto, headings as defaultHeadings } from '../data/wedding.js';
const {
  couple = defaultCouple,
  details = defaultDetails,
  schedule = defaultSchedule,
  venuePhoto = defaultVenuePhoto,
  heading = defaultHeadings.details,
  scheduleHeading = defaultHeadings.schedule,
} = Astro.props;

// A pasted Google Maps share link is used as-is; without one, fall back to a
// maps search built from whatever venue name/address is on file, so the
// card is always tappable as long as there's something to search for.
type Detail = { mapUrl?: string; venue?: string; address?: string };

const mapQuery = (d: Detail) => [d.venue, d.address].filter(Boolean).join(', ');

const mapLink = (d: Detail) => {
  if (d.mapUrl) return d.mapUrl;
  const query = mapQuery(d);
  return query ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}` : null;
};

// A small embedded map under each card. A pasted share link can't be framed,
// so the preview is always searched by venue/address (which is what the link
// resolves to anyway) while the tap target keeps using whatever mapUrl says.
const mapEmbed = (d: Detail) => {
  const query = mapQuery(d);
  return query ? `https://maps.google.com/maps?q=${encodeURIComponent(query)}&z=15&output=embed` : null;
};

// "Add to Google Calendar" — Google's template link wants both ends of the
// event in UTC basic form. The start is the couple's date; without an explicit
// finish we block out five hours, which covers ceremony through reception.
const HOURS = 5;

const stamp = (d: Date) => d.toISOString().replace(/[-:]|\.\d{3}/g, '');

const calendarUrl = (() => {
  const start = new Date(couple.date);
  if (Number.isNaN(start.getTime())) return null;
  const end = new Date(start.getTime() + HOURS * 60 * 60 * 1000);
  // The ceremony card is the most precise address the page has; the wedding's
  // own venue is next, and the city is the last resort.
  const where = details.map((d: Detail) => mapQuery(d)).filter(Boolean)[0]
    || [couple.venue, couple.city].filter(Boolean).join(', ');
  const params = new URLSearchParams({
    action: 'TEMPLATE',
    text: `The wedding of ${couple.bride} & ${couple.groom}`,
    dates: `${stamp(start)}/${stamp(end)}`,
    details: `We would love to have you with us. ${couple.hashtag || ''}`.trim(),
    location: where,
  });
  return `https://calendar.google.com/calendar/render?${params.toString()}`;
})();
---
<section class="section details" id="details">
  <div class="wrap">
    <header class="details__head">
      <p class="eyebrow" data-reveal>{heading.eyebrow}</p>
      <h2 data-split>{heading.title}</h2>
    </header>

    <div class="cards" data-stagger="160">
      {details.map((d, i) => {
        const href = mapLink(d);
        const embed = mapEmbed(d);
        return (
          <article class="card" data-reveal={i % 2 ? 'right' : 'left'} data-tilt>
            <div class="card__inner">
              <span class="card__corner card__corner--tl" aria-hidden="true"></span>
              <span class="card__corner card__corner--br" aria-hidden="true"></span>
              <p class="card__label">{d.label}</p>
              <p class="card__time script">{d.time}</p>
              {href ? (
                <a class="card__map" href={href} target="_blank" rel="noreferrer noopener">
                  <h3>{d.venue}</h3>
                  <p class="card__address">{d.address}</p>
                  {embed && (
                    <span class="card__mapview">
                      <iframe
                        src={embed}
                        title={`Map of ${d.venue ?? d.label}`}
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        tabindex="-1"
                        aria-hidden="true"
                      ></iframe>
                      <span class="card__veil" aria-hidden="true"></span>
                      <span class="card__pin" aria-hidden="true"></span>
                      <span class="card__cta">View on the map</span>
                    </span>
                  )}
                </a>
              ) : (
                <div class="card__map">
                  <h3>{d.venue}</h3>
                  <p class="card__address">{d.address}</p>
                </div>
              )}
              <p class="card__note">{d.note}</p>
            </div>
          </article>
        );
      })}
    </div>

    {calendarUrl && (
      <p class="calendar" data-reveal style="--reveal-delay:200ms">
        <a class="calendar__link" href={calendarUrl} target="_blank" rel="noreferrer noopener">
          <svg class="calendar__icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="5" width="18" height="16" rx="2" />
            <path d="M3 10h18M8 3v4M16 3v4M12 13v5M9.5 15.5h5" />
          </svg>
          <span>Add to Google Calendar</span>
        </a>
      </p>
    )}
  </div>

  <figure class="banner" data-curtain data-wipe="left">
    <span class="banner__layer" data-parallax="0.3" data-scrub="zoom">
      <img src={venuePhoto.src} alt={venuePhoto.alt} loading="lazy" decoding="async" />
    </span>
  </figure>

  {schedule.length > 0 && (
  <div class="wrap narrow">
    <h3 class="schedule__title" data-reveal>{scheduleHeading.title}</h3>
    <div class="schedule__wrap" data-timeline>
      <span class="schedule__rail" aria-hidden="true"><i class="schedule__fill" data-rail-fill></i></span>
      <ol class="schedule">
        {schedule.map((row) => (
          <li class="schedule__row" data-row>
            <span class="schedule__marker" aria-hidden="true"></span>
            <span class="schedule__time">{row.time}</span>
            <span class="schedule__dots" aria-hidden="true"></span>
            <span class="schedule__event">{row.event}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
  )}
</section>

<style>
  .details { background: var(--ivory); padding-inline: 0; }
  .details__head { text-align: center; margin-bottom: clamp(2.5rem, 7vh, 4.5rem); }
  .details__head h2 { font-size: clamp(2rem, 5vw, 3.4rem); }
  .details .wrap { padding-inline: var(--gutter); }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .card { perspective: 900px; }
  .card__inner {
    --card-pad: clamp(1.75rem, 4vw, 2.75rem);
    position: relative;
    border: var(--rule);
    padding: var(--card-pad);
    background: var(--ivory);
    text-align: center;
    transform-style: preserve-3d;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s ease;
  }
  .card[data-tilting] .card__inner { transition: box-shadow 0.5s ease; }
  .card:hover .card__inner { box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.35); }

  /* Gold brackets that draw themselves out from the corners on hover */
  .card__corner {
    position: absolute;
    width: 26px;
    height: 26px;
    border: 0 solid var(--gold);
    opacity: 0;
    transition: opacity 0.5s ease, width 0.5s ease, height 0.5s ease;
  }
  .card__corner--tl {
    top: -1px;
    left: -1px;
    border-top-width: 1px;
    border-left-width: 1px;
  }
  .card__corner--br {
    right: -1px;
    bottom: -1px;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }
  .card:hover .card__corner { opacity: 1; width: 46px; height: 46px; }
  .card__label {
    font-size: 0.65rem;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.2rem;
  }
  .card__time { font-size: 1.5rem; margin-bottom: 0.75rem; }
  .card h3 { font-size: clamp(1.5rem, 2.6vw, 2rem); margin-bottom: 0.5rem; }
  .card__address { color: var(--ink-soft); margin-bottom: 0; }

  .card__map {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .card__map h3 { transition: color 0.4s ease; }
  .card__map:hover h3,
  .card__map:focus-visible h3 { text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: 4px; }

  /* The map is drawn as part of the stationery rather than dropped in as a
     widget: a wide band bled to the card's edges, desaturated, and dissolved
     into the ivory at every side so it reads as an engraved plate. The pin,
     the ring and the caption are ours — Google's own chrome never shows. */
  .card__mapview {
    display: block;
    position: relative;
    margin: 1.4rem calc(-1 * var(--card-pad)) 0;
    height: clamp(150px, 22vw, 190px);
    overflow: hidden;
    border-block: var(--rule);
    background: var(--gold-light);
    isolation: isolate;
  }
  /* Preview only — the card's link is the way in. Leaving the frame inert
     keeps the tilt tracking the pointer and stops the map swallowing scroll
     gestures on touch. */
  .card__mapview iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
    filter: grayscale(1) sepia(0.35) contrast(0.92) brightness(1.06);
    transform: scale(1.08);
    transition: filter 0.7s ease, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .card:hover .card__mapview iframe {
    filter: grayscale(0.25) sepia(0.1);
    transform: scale(1.14);
  }

  /* Ivory bleeding in from the edges, so the plate has no hard seam */
  .card__veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 50% 45%, transparent 30%, var(--ivory) 100%),
      linear-gradient(to top, var(--ivory) 2%, transparent 40%);
    opacity: 0.92;
    transition: opacity 0.7s ease;
  }
  .card:hover .card__veil { opacity: 0.7; }

  /* Gold pin with a ring that breathes outward on hover */
  .card__pin {
    position: absolute;
    left: 50%;
    top: 46%;
    width: 11px;
    height: 11px;
    margin: -5.5px 0 0 -5.5px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 3px var(--ivory), 0 6px 14px -6px rgba(0, 0, 0, 0.6);
  }
  .card__pin::after {
    content: '';
    position: absolute;
    inset: -9px;
    border: 1px solid var(--gold);
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.6);
  }
  .card:hover .card__pin::after { animation: pin-ring 1.9s ease-out infinite; }
  @keyframes pin-ring {
    0% { opacity: 0.85; transform: scale(0.6); }
    100% { opacity: 0; transform: scale(1.9); }
  }

  .card__cta {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.85rem;
    text-align: center;
    font-size: 0.6rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--gold);
    opacity: 0;
    transform: translate3d(0, 6px, 0);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .card:hover .card__cta,
  .card__map:focus-visible .card__cta { opacity: 1; transform: none; }
  .card__note {
    font-size: 0.82rem;
    color: var(--ink-soft);
    border-top: var(--rule);
    padding-top: 1.2rem;
    margin: 1.4rem 0 0;
  }
  /* The plate already closes with a rule, so the note skips its own */
  .card__map:has(.card__mapview) + .card__note { border-top: 0; padding-top: 0; }

  /* A quiet second action under the venue cards — engraved rule, not a button */
  .calendar { text-align: center; margin: clamp(2rem, 5vh, 3rem) 0 0; }
  .calendar__link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.6rem;
    border: var(--rule);
    color: var(--ink);
    text-decoration: none;
    font-size: 0.68rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    background: transparent;
    transition: background 0.5s ease, color 0.5s ease, border-color 0.5s ease;
  }
  .calendar__link:hover,
  .calendar__link:focus-visible {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--ivory);
  }
  .calendar__icon {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }

  .banner {
    position: relative;
    margin: clamp(4rem, 10vh, 7rem) 0;
    height: clamp(280px, 55vh, 620px);
    overflow: hidden;
  }
  .banner__layer { position: absolute; left: 0; right: 0; top: -15%; height: 130%; will-change: transform; }
  .banner img { width: 100%; height: 100%; object-fit: cover; }

  .schedule__title {
    text-align: center;
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    margin-bottom: 2.5rem;
  }
  .schedule__wrap { position: relative; }
  .schedule {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.9rem;
    display: grid;
    gap: 1.4rem;
  }
  /* Rail that fills as the list scrolls through the viewport */
  .schedule__rail {
    position: absolute;
    left: 4px;
    top: 0.55em;
    bottom: 0.55em;
    width: 1px;
    background: var(--gold-light);
    opacity: 0.45;
  }
  .schedule__fill {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--gold);
    transform: scaleY(var(--fill, 0));
    transform-origin: top;
    will-change: transform;
  }
  .schedule__row {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    opacity: 0.35;
    transform: translate3d(0, 12px, 0);
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .schedule__row.is-lit { opacity: 1; transform: none; }
  .schedule__marker {
    position: absolute;
    left: calc(-1.9rem + 1px);
    top: 0.45em;
    width: 7px;
    height: 7px;
    border: 1px solid var(--gold);
    border-radius: 50%;
    background: var(--ivory);
    transform: scale(0.6);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), background 0.5s ease;
  }
  .schedule__row.is-lit .schedule__marker { transform: scale(1); background: var(--gold); }
  .schedule__time {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    text-transform: uppercase;
    color: var(--gold);
    min-width: 6.5em;
  }
  .schedule__dots {
    flex: 1;
    height: 1px;
    background-image: linear-gradient(90deg, var(--gold-light) 40%, transparent 40%);
    background-size: 6px 1px;
    opacity: 0.7;
  }
  .schedule__event { font-family: var(--font-display); font-size: 1.25rem; }

  @media (prefers-reduced-motion: reduce) {
    .card__inner, .schedule__row, .schedule__marker,
    .card__mapview iframe, .card__veil, .card__cta { transition-duration: 0.01ms; }
    .card__pin::after { animation: none; }
    .schedule__row { opacity: 1; transform: none; }
    .schedule__fill { transform: scaleY(1); }
  }
</style>

<script>
  const initDetails = () => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ── Cards follow the pointer with a slight 3D tilt ──────────── */
    document.querySelectorAll('[data-tilt]').forEach((card) => {
      if (card.dataset.ready === '1') return;
      card.dataset.ready = '1';
      const inner = card.querySelector('.card__inner');
      if (!inner || reduced) return;

      let frame = 0;
      const move = (e) => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const r = card.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          inner.style.transform =
            `rotateX(${(-y * 6).toFixed(2)}deg) rotateY(${(x * 6).toFixed(2)}deg) translateZ(6px)`;
        });
      };

      card.addEventListener('pointermove', move);
      card.addEventListener('pointerenter', () => card.setAttribute('data-tilting', ''));
      card.addEventListener('pointerleave', () => {
        card.removeAttribute('data-tilting');
        inner.style.transform = '';
      });
    });

    /* ── Schedule rail fills with scroll; rows light as they pass ── */
    const list = document.querySelector('[data-timeline]');
    if (!list || list.dataset.ready === '1') return;
    list.dataset.ready = '1';

    const fill = list.querySelector('[data-rail-fill]');
    const rows = [...list.querySelectorAll('[data-row]')];

    if (reduced) {
      rows.forEach((row) => row.classList.add('is-lit'));
      return;
    }

    let inView = false;
    let ticking = false;

    const update = () => {
      ticking = false;
      const r = list.getBoundingClientRect();
      const line = window.innerHeight * 0.72;
      const progress = Math.min(1, Math.max(0, (line - r.top) / r.height));
      if (fill) fill.style.setProperty('--fill', progress.toFixed(3));
      rows.forEach((row) => {
        const rr = row.getBoundingClientRect();
        row.classList.toggle('is-lit', rr.top < line);
      });
    };

    const onScroll = () => {
      if (!inView || ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);

    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        if (inView) onScroll();
      },
      { rootMargin: '20% 0px' }
    ).observe(list);

    update();
  };

  initDetails();
  document.addEventListener('astro:page-load', initDetails);
</script>

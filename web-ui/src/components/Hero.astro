---
import { couple, hero } from '../data/wedding.js';
---
<header class="hero" id="top">
  <!-- The reveal itself is owned by the envelope's curtain (Envelope.astro);
       the hero photo sits fully visible beneath it from the start so the
       curtain parts onto a finished stage rather than a fading one. -->
  <div class="hero__media">
    <img
      data-hero-photo
      src={hero.src}
      alt={hero.alt}
      width="2000"
      height="1250"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero__clouds" data-vanta-clouds aria-hidden="true"></div>
  </div>

  <div class="hero__inner">
    <p class="eyebrow" data-hero-line>Together with their families</p>
    <h1 class="hero__names">
      <span data-split>{couple.bride}</span>
      <em class="script" data-hero-line>and</em>
      <span data-split data-split-delay="450">{couple.groom}</span>
    </h1>
    <div class="hero__rule" data-hero-rule></div>
    <p class="hero__meta" data-hero-line>{couple.dateLabel} &nbsp;·&nbsp; {couple.city}</p>

    <div class="hero__actions" data-hero-line>
      <a class="btn btn--solid" href="#rsvp" data-magnetic>
        <span class="btn__fill" aria-hidden="true"></span>
        <span class="btn__label">
          <span class="btn__text">Reserve your seat</span>
          <span class="btn__text btn__text--alt" aria-hidden="true">Reserve your seat</span>
        </span>
        <svg class="btn__icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 6.5h18v11H3z" />
          <path d="M3 7l9 6.5L21 7" />
        </svg>
      </a>

      <a class="btn btn--ghost" href="#details" data-magnetic>
        <span class="btn__fill" aria-hidden="true"></span>
        <span class="btn__label">
          <span class="btn__text">Find the venue</span>
          <span class="btn__text btn__text--alt" aria-hidden="true">Find the venue</span>
        </span>
        <svg class="btn__icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11z" />
          <circle cx="12" cy="10" r="2.6" />
        </svg>
      </a>
    </div>
    <a class="hero__scroll" href="#invitation" data-hero-line>
      <i aria-hidden="true"></i>
    </a>
  </div>
</header>

<script>
  import * as THREE from 'three';
  import vantaClouds2 from 'vanta/dist/vanta.clouds2.min.js';

  const CLOUDS2 = vantaClouds2 as unknown as (options: Record<string, unknown>) => { destroy: () => void };

  const el = document.querySelector('[data-vanta-clouds]');
  if (el && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const effect = CLOUDS2({
      el,
      THREE,
      // No pointer/gyro tracking — this is a static atmospheric backdrop,
      // and skipping the per-frame raycast avoids extra main-thread work.
      mouseControls: false,
      touchControls: false,
      gyroControls: false,
      minHeight: 200.0,
      minWidth: 200.0,
      // Raymarched fragment shader is expensive per-pixel; a higher scale
      // divides the effective render resolution (devicePixelRatio/scale)
      // to keep it smooth on retina displays instead of stuttering.
      scale: 2.0,
      texturePath: '/gallery/noise.png',
    });

    window.addEventListener('beforeunload', () => effect.destroy());
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    isolation: isolate;
    overflow: hidden;
    color: var(--ivory);
    text-align: center;
    padding: 6rem var(--gutter) 4rem;
  }

  .hero__media { position: absolute; inset: 0; z-index: 0; background: #2a2420; }
  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Already visible at rest — the envelope's curtain is what's covering
       it, not this image's own opacity. A slight over-zoom lets JS ease it
       down to 1 as the curtain parts, for a subtle sense of depth. */
    opacity: 1;
    transform: scale(1.12);
    will-change: transform;
  }
  .hero__clouds {
    position: absolute;
    inset: 0;
    z-index: 1;
    mix-blend-mode: screen;
    opacity: 0.55;
    pointer-events: auto;
    mask-image: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.35) 35%, rgba(0, 0, 0, 0.85) 70%, #000 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.35) 35%, rgba(0, 0, 0, 0.85) 70%, #000 100%);
  }
  .hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 50% 40%, transparent 20%, rgba(24, 19, 15, 0.62) 100%),
      linear-gradient(180deg, rgba(24, 19, 15, 0.35), rgba(24, 19, 15, 0.5));
  }

  .hero__inner { position: relative; z-index: 2; max-width: 60rem; }

  .hero__names {
    font-size: clamp(3.4rem, 13vw, 9.5rem);
    line-height: 0.95;
    margin: 0.2em 0 0;
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.35);
  }
  .hero__names em {
    display: block;
    font-size: 0.26em;
    line-height: 1.6;
    color: var(--gold-light);
    margin: 0.45em 0 0.3em;
    opacity: 0;
  }

  .hero__rule {
    width: min(340px, 60vw);
    height: 1px;
    margin: 2.4rem auto 1.8rem;
    background: linear-gradient(90deg, transparent, var(--gold-light), transparent);
    transform: scaleX(0);
  }

  .hero__meta {
    font-size: 0.78rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    opacity: 0;
    margin: 0;
  }

  /* ── Hero call-to-action pair ───────────────────────────────── */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    margin-top: clamp(2rem, 5vh, 3rem);
    opacity: 0;
  }

  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.95rem 1.7rem;
    border: 1px solid var(--gold-light);
    text-decoration: none;
    color: var(--ivory);
    font-size: 0.68rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    overflow: hidden;
    isolation: isolate;
    background: rgba(24, 19, 15, 0.28);
    backdrop-filter: blur(3px);
    transition: border-color 0.5s ease, box-shadow 0.5s ease;
    will-change: transform;
  }
  .btn--solid { border-color: var(--gold); }

  /* Gold panel wipes up from the baseline on hover */
  .btn__fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--gold);
    transform: scaleY(0);
    transform-origin: 50% 100%;
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .btn:hover .btn__fill,
  .btn:focus-visible .btn__fill { transform: scaleY(1); }

  /* Label rolls: the resting text lifts out, its twin rolls up behind it */
  /* The window must clear the full line box — a 1em box crops caps
     and descenders, which is what "half the text" looked like. */
  .btn__label {
    position: relative;
    display: block;
    overflow: hidden;
    line-height: 1.5;
    height: 1.5em;
  }
  .btn__text {
    display: block;
    line-height: 1.5;
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1), color 0.4s ease;
  }
  .btn__text--alt { position: absolute; inset: 0; transform: translateY(100%); }
  /* Only the resting label leaves; its twin travels up INTO the window. */
  .btn:hover .btn__text:not(.btn__text--alt),
  .btn:focus-visible .btn__text:not(.btn__text--alt) { transform: translateY(-100%); }
  .btn:hover .btn__text--alt,
  .btn:focus-visible .btn__text--alt { transform: translateY(0); }
  .btn:hover, .btn:focus-visible { border-color: var(--gold); box-shadow: 0 18px 40px -22px rgba(0, 0, 0, 0.8); }
  .btn:hover .btn__text--alt,
  .btn:focus-visible .btn__text--alt { color: #2a2016; }

  .btn__icon {
    width: 15px;
    height: 15px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: var(--gold-light);
    transition: color 0.4s ease, transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .btn:hover .btn__icon,
  .btn:focus-visible .btn__icon { color: #2a2016; transform: translateY(-2px); }

  @media (max-width: 480px) {
    .hero__actions { flex-direction: column; align-items: stretch; }
    .btn { justify-content: center; }
  }

  .hero__eyebrow, .eyebrow { color: var(--gold-light); }
  .hero .eyebrow { opacity: 0; margin-bottom: 0; color: #e6d3ac; }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: clamp(1.5rem, 5vh, 3rem);
    transform: translateX(-50%);
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    font-size: 0.62rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ivory);
    opacity: 0;
  }
  .hero__scroll i {
    width: 1px;
    height: 54px;
    background: linear-gradient(180deg, var(--gold-light), transparent);
    animation: drop 2.4s var(--ease-out-expo) infinite;
  }
  @keyframes drop {
    0% { transform: scaleY(0); transform-origin: 50% 0%; }
    45% { transform: scaleY(1); transform-origin: 50% 0%; }
    46% { transform: scaleY(1); transform-origin: 50% 100%; }
    100% { transform: scaleY(0); transform-origin: 50% 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__media img { transform: none; }
    .hero .eyebrow, .hero__meta, .hero__scroll, .hero__names em, .hero__actions { opacity: 1; }
    .btn, .btn__fill, .btn__text, .btn__icon { transition-duration: 0.01ms; }
    .hero__rule { transform: none; }
    .hero__scroll i { animation: none; }
  }
</style>

<script>
  /* The buttons drift a few pixels toward the cursor, then spring back. */
  const initMagnetic = () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!window.matchMedia('(hover: hover)').matches) return;

    document.querySelectorAll('[data-magnetic]').forEach((btn) => {
      if (btn.dataset.ready === '1') return;
      btn.dataset.ready = '1';

      let frame = 0;
      const el = btn as HTMLElement;

      el.addEventListener('pointermove', (e) => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const r = el.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          el.style.transform = `translate3d(${(x * 14).toFixed(1)}px, ${(y * 8).toFixed(1)}px, 0)`;
        });
      });

      el.addEventListener('pointerleave', () => {
        el.style.transition = 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.5s ease, box-shadow 0.5s ease';
        el.style.transform = '';
        setTimeout(() => { el.style.transition = ''; }, 620);
      });
    });
  };

  initMagnetic();
  document.addEventListener('astro:page-load', initMagnetic);
</script>

---
import { couple as defaultCouple, hero as defaultHero, headings as defaultHeadings } from '../data/wedding.js';
/* "Modern" hero: a static split layout (text panel + photo panel) instead
   of classic's full-bleed photo with centered overlay text and vanta
   cloud effect. Same props as Hero.astro. */
const { couple = defaultCouple, hero = defaultHero, heading = defaultHeadings.hero } = Astro.props;
---
<header class="hero-modern" id="top">
  <div class="hero-modern__text">
    <p class="hero-modern__eyebrow">{heading.eyebrow}</p>
    <h1 class="hero-modern__names">
      <span>{couple.bride}</span>
      <span>{couple.groom}</span>
    </h1>
    <p class="hero-modern__meta">{couple.dateLabel}<br />{couple.city}</p>
    <div class="hero-modern__actions">
      <a class="hero-modern__link hero-modern__link--solid" href="#rsvp">Reserve your seat</a>
      <a class="hero-modern__link" href="#details">Find the venue</a>
    </div>
  </div>
  <div class="hero-modern__media">
    <img src={hero.src} alt={hero.alt} width="1200" height="1500" fetchpriority="high" decoding="async" />
  </div>
</header>

<style>
  .hero-modern {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100svh;
  }
  .hero-modern__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
    padding: clamp(2rem, 6vw, 6rem);
    background: var(--ivory);
  }
  .hero-modern__eyebrow {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .hero-modern__names {
    margin: 0;
    display: flex;
    flex-direction: column;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    line-height: 0.98;
    color: var(--ink);
  }
  .hero-modern__meta {
    margin: 0;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    line-height: 1.8;
  }
  .hero-modern__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }
  .hero-modern__link {
    padding: 0.9rem 1.6rem;
    border: 1px solid var(--gold);
    color: var(--ink);
    text-decoration: none;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: background 0.3s ease, color 0.3s ease;
  }
  .hero-modern__link--solid { background: var(--gold); color: var(--ivory); }
  .hero-modern__link:hover { background: var(--gold); color: var(--ivory); }

  .hero-modern__media { position: relative; overflow: hidden; }
  .hero-modern__media img { width: 100%; height: 100%; object-fit: cover; display: block; }

  @media (max-width: 820px) {
    .hero-modern { grid-template-columns: 1fr; }
    .hero-modern__media { min-height: 50vh; order: -1; }
  }
</style>

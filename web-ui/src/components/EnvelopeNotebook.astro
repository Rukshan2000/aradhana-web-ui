---
import { couple as defaultCouple, guest as fallbackGuest } from '../data/wedding.js';
/* The "notebook" gate: the closed cover of the book, with a paper label
   taped to the front. Same contract as Envelope.astro (data-envelope,
   data-open-invitation, envelope-lock, invitation:open) so motion.js,
   track.js and Music.astro hook into it unchanged. */
const { guest = fallbackGuest, couple = defaultCouple, openInvite = false } = Astro.props;
const addressee = openInvite ? 'Our guest' : guest.name;
---
<div class="cover" id="envelope" data-envelope>
  <div class="cover__book">
    <span class="cover__band" aria-hidden="true"></span>
    <div class="cover__label">
      <span class="cover__tape cover__tape--l" aria-hidden="true"></span>
      <span class="cover__tape cover__tape--r" aria-hidden="true"></span>
      <p class="cover__hand">the wedding of</p>
      <p class="cover__names">{couple.bride} &amp; {couple.groom}</p>
      <p class="cover__meta">{couple.dateLabel}</p>
      <p class="cover__for">kept for {addressee}</p>
    </div>
  </div>

  <button type="button" class="cover__button" data-open-invitation data-open>
    Open the book
  </button>
</div>

<style>
  .cover {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    grid-auto-rows: min-content;
    align-content: center;
    justify-items: center;
    gap: clamp(1.75rem, 5vh, 3rem);
    padding: 2rem 1.25rem;
    background: #6c5637;
    background-image:
      radial-gradient(120% 90% at 50% 22%, rgba(255, 240, 205, 0.16), transparent 72%),
      radial-gradient(90% 70% at 50% 100%, rgba(38, 27, 12, 0.45), transparent 70%);
    transition: opacity 0.7s ease, visibility 0.7s;
  }

  /* The book itself: a cloth board with a stitched edge and a strap. */
  .cover__book {
    position: relative;
    width: min(420px, 86vw);
    aspect-ratio: 3 / 4;
    border-radius: 3px 8px 8px 3px;
    background: linear-gradient(100deg, #4f3f28 0 5%, #6d5738 6%, #7d6743 55%, #5f4b30 100%);
    box-shadow:
      inset -14px 0 26px -18px rgba(0, 0, 0, 0.7),
      0 30px 50px -22px rgba(30, 20, 8, 0.75);
  }
  /* stitching just inside the board edge */
  .cover__book::before {
    content: "";
    position: absolute;
    inset: 14px 14px 14px 26px;
    border: 1px dashed rgba(238, 223, 186, 0.35);
    border-radius: 2px;
    pointer-events: none;
  }
  /* the elastic closure band */
  .cover__band {
    position: absolute;
    top: -2%;
    right: 16%;
    width: 14px;
    height: 104%;
    background: linear-gradient(90deg, #2c2318, #453724 40%, #241d13);
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.4);
  }

  /* A slip of ruled paper taped to the cover. */
  .cover__label {
    position: absolute;
    top: 22%;
    left: 12%;
    width: 62%;
    padding: 1.25rem 1rem 1.4rem;
    rotate: -1.6deg;
    text-align: center;
    color: #2c3a52;
    background-color: #fdfaf0;
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 1.45rem,
      rgba(94, 130, 168, 0.35) 1.45rem,
      rgba(94, 130, 168, 0.35) calc(1.45rem + 1px)
    );
    box-shadow: 0 8px 18px -10px rgba(20, 12, 4, 0.7);
  }
  .cover__tape {
    position: absolute;
    top: -0.75rem;
    width: 3.6rem;
    height: 1.35rem;
    background: rgba(236, 226, 194, 0.72);
    box-shadow: 0 1px 2px rgba(60, 46, 20, 0.3);
  }
  .cover__tape--l { left: -1rem; rotate: -28deg; }
  .cover__tape--r { right: -1rem; rotate: 26deg; }

  .cover__hand {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.45rem;
  }
  .cover__names {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.9rem, 6vw, 2.6rem);
    line-height: 1.45rem;
    padding: 0.6rem 0;
  }
  .cover__meta,
  .cover__for {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.82rem;
    line-height: 1.45rem;
  }
  .cover__for { color: #7a6a4a; }

  .cover__button {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: #fdfaf0;
    background: transparent;
    border: none;
    border-bottom: 2px solid rgba(253, 250, 240, 0.6);
    padding: 0.1rem 0.6rem 0.2rem;
    cursor: pointer;
    transition: border-color 0.3s ease;
  }
  .cover__button:hover { border-bottom-color: #fdfaf0; }
  .cover__button:disabled { pointer-events: none; opacity: 0.5; }

  .cover.is-open { opacity: 0; visibility: hidden; pointer-events: none; }
  html.envelope-lock, html.envelope-lock body { overflow: hidden; height: 100%; }

  @media (prefers-reduced-motion: reduce) {
    .cover { transition: opacity 0.3s linear, visibility 0.3s; }
  }
</style>

<script>
  const cover = document.querySelector<HTMLElement>('[data-envelope]');
  const button = document.querySelector<HTMLButtonElement>('[data-open-invitation]');

  if (cover && button) {
    document.documentElement.classList.add('envelope-lock');

    button.addEventListener('click', () => {
      button.disabled = true;
      window.dispatchEvent(new CustomEvent('invitation:open'));
      document.documentElement.classList.remove('envelope-lock');
      cover.classList.add('is-open');
      window.scrollTo(0, 0);
      window.setTimeout(() => cover.remove(), 750);
    });
  }
</script>

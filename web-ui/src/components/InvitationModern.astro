---
import { couple as defaultCouple, guest as fallbackGuest, headings as defaultHeadings } from '../data/wedding.js';
/* "Modern" invitation section: an asymmetric two-column layout (numeral +
   addressee sidebar, content block) instead of classic's centered plate.
   Same props as Invitation.astro. */
const { guest = fallbackGuest, couple = defaultCouple, openInvite = false, heading = defaultHeadings.invitation } = Astro.props;
const addressee = openInvite ? 'Invitation for you' : guest.name;
---
<section class="section invitation-modern" id="invitation">
  <div class="invitation-modern__grid">
    <div class="invitation-modern__side">
      <span class="invitation-modern__num">01</span>
      <p class="invitation-modern__eyebrow">{heading.eyebrow}</p>
      {!openInvite && (
        <p class="invitation-modern__to">
          {addressee}<br /><span>{guest.household}</span>
        </p>
      )}
    </div>
    <div class="invitation-modern__main">
      <h2 class="invitation-modern__head">{heading.title}</h2>
      <p class="invitation-modern__body">
        With hearts full of gratitude, {couple.bride} and {couple.groom} request the pleasure
        of your company as they exchange vows and begin their life together.
      </p>
      <p class="invitation-modern__date">{couple.dateLabel} · {couple.city}</p>
      <a class="invitation-modern__cta" href="#rsvp">Confirm participation →</a>
    </div>
  </div>
</section>

<style>
  .invitation-modern { background: var(--ivory); }
  .invitation-modern__grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(2rem, 6vw, 5rem);
  }
  .invitation-modern__side { display: flex; flex-direction: column; gap: 1rem; }
  .invitation-modern__num {
    font-size: 3rem;
    line-height: 1;
    color: var(--blush);
    font-family: var(--font-display);
  }
  .invitation-modern__eyebrow {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .invitation-modern__to {
    margin: 0;
    font-size: 1rem;
    color: var(--ink);
  }
  .invitation-modern__to span {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .invitation-modern__head {
    margin: 0 0 1.5rem;
    font-size: clamp(2rem, 5vw, 3.2rem);
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .invitation-modern__body {
    margin: 0 0 2rem;
    max-width: 40em;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: var(--ink-soft);
  }
  .invitation-modern__date {
    margin: 0 0 2rem;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .invitation-modern__cta {
    display: inline-block;
    color: var(--gold);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--gold);
    padding-bottom: 0.2rem;
  }

  @media (max-width: 720px) {
    .invitation-modern__grid { grid-template-columns: 1fr; }
  }
</style>

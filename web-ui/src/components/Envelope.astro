---
import { couple, guest as fallbackGuest } from '../data/wedding.js';
const { guest = fallbackGuest } = Astro.props;
---
<div class="envelope" id="envelope" data-envelope>
  <div class="envelope__veil" aria-hidden="true"></div>

  <div class="envelope__stage" data-stage>
    <div class="paper" data-paper>
      <!-- Back panel: the sheet everything else is folded out of -->
      <div class="paper__back" aria-hidden="true"></div>

      <!-- The card lives inside the pocket and slides out on open -->
      <div class="card" data-card>
        <div class="card__inner">
          <p class="card__to">
            <span class="card__to-label">For</span>
            <span class="card__to-name">{guest.name}</span>
            <span class="card__to-label">{guest.household}</span>
          </p>
          <p class="card__eyebrow">The wedding of</p>
          <h1 class="card__names">
            {couple.bride} <em>&amp;</em> {couple.groom}
          </h1>
          <div class="card__rule"></div>
          <p class="card__meta">{couple.dateLabel}</p>
          <p class="card__meta card__meta--city">{couple.city}</p>
        </div>
      </div>

      <!-- Front pocket, cut with the V that a real envelope shows -->
      <div class="paper__pocket" aria-hidden="true"></div>

      <!-- The flap that peels back over the top -->
      <div class="paper__flap" data-flap aria-hidden="true">
        <div class="paper__flap-face paper__flap-face--out"></div>
        <div class="paper__flap-face paper__flap-face--in"></div>
      </div>

      <!-- Wax seal, cracked in two halves -->
      <div class="seal" data-seal aria-hidden="true">
        <div class="seal__half seal__half--l"><span>A</span></div>
        <div class="seal__half seal__half--r"><span>N</span></div>
      </div>
    </div>

    <div class="envelope__shadow" data-shadow aria-hidden="true"></div>
  </div>

  <button type="button" class="envelope__button" data-open-invitation>
    <span>Open Invitation</span>
  </button>
  <p class="envelope__hint" data-hint>break the seal</p>
</div>

<style>
  .envelope {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    grid-auto-rows: min-content;
    align-content: center;
    justify-items: center;
    gap: clamp(1.75rem, 5vh, 3rem);
    background: #17130f;
    color: var(--ivory);
    text-align: center;
    padding: 2rem 1.25rem;
    overflow: hidden;
    transition: opacity 0.9s var(--ease-out-expo), visibility 0.9s;
  }
  .envelope__veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(90% 70% at 50% 42%, rgba(176, 141, 79, 0.20), transparent 62%),
      radial-gradient(60% 50% at 50% 100%, rgba(0, 0, 0, 0.6), transparent 70%);
    pointer-events: none;
  }
  .envelope::after {
    content: "";
    position: absolute;
    inset: clamp(0.75rem, 3vw, 1.75rem);
    border: 1px solid rgba(216, 189, 138, 0.22);
    pointer-events: none;
  }

  /* ── the physical object ───────────────────────────────────── */
  .envelope__stage {
    position: relative;
    perspective: 1050px;
    perspective-origin: 50% 30%;
    width: min(560px, 84vw);
  }

  .paper {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    transform-style: preserve-3d;
    will-change: transform;
    cursor: pointer;
  }

  .paper__back,
  .paper__pocket,
  .paper__flap-face {
    position: absolute;
    inset: 0;
    background: linear-gradient(155deg, #f7f1e5 0%, #ece0cb 58%, #dccbae 100%);
  }
  /* Paper tooth: the noise tile sits on top at low opacity, desaturated,
     so it grains the surface instead of colouring it. */
  .paper__back::before,
  .paper__pocket::before,
  .paper__flap-face::before {
    content: "";
    position: absolute;
    inset: 0;
    background: url('/gallery/noise.png') repeat;
    background-size: 180px;
    filter: grayscale(1) contrast(0.6);
    opacity: 0.09;
    mix-blend-mode: multiply;
    pointer-events: none;
    clip-path: inherit;
  }

  .paper__back {
    border-radius: 3px;
    box-shadow: inset 0 0 60px rgba(120, 96, 60, 0.22);
  }

  /* Front pocket: two folded side panels leaving a V at the top */
  .paper__pocket {
    transform: translateZ(14px);
    clip-path: polygon(0 0, 50% 46%, 100% 0, 100% 100%, 0 100%);
    border-radius: 0 0 3px 3px;
    background: linear-gradient(170deg, #f2e9d9 0%, #e4d6bc 60%, #d5c3a3 100%);
    filter: drop-shadow(0 -3px 6px rgba(70, 52, 28, 0.25));
  }
  /* the seams where the side panels fold over */
  .paper__pocket::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom right, rgba(255,255,255,0.35), transparent 52%),
      linear-gradient(to bottom left, rgba(120, 96, 58, 0.16), transparent 52%);
    clip-path: inherit;
  }

  .paper__flap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 47%;
    transform-origin: 50% 0%;
    transform: translateZ(16px) rotateX(0deg);
    transform-style: preserve-3d;
    will-change: transform;
  }
  .paper__flap-face {
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    backface-visibility: hidden;
  }
  .paper__flap-face--out {
    background: linear-gradient(190deg, #f8f2e6 0%, #eaddc6 70%, #dbc9a8 100%);
    filter: drop-shadow(0 6px 10px rgba(60, 44, 22, 0.35));
  }
  /* The underside you see once the flap is peeled back. It is flipped about
     its own centre to face backwards, so its triangle has to be mirrored to
     land on the same silhouette as the outer face — otherwise the open flap
     reads as a downward V instead of the upward point a folded-back flap makes. */
  .paper__flap-face--in {
    clip-path: polygon(0 100%, 100% 100%, 50% 0);
    transform: rotateX(180deg);
    background: linear-gradient(0deg, #f0e6d2 0%, #d9c8a6 55%, #c3ae86 100%);
  }

  /* ── the card ──────────────────────────────────────────────── */
  .card {
    position: absolute;
    left: 4%;
    top: 4%;
    width: 92%;
    height: 92%;
    transform: translateZ(6px);
    transform-origin: 50% 100%;
    background: linear-gradient(170deg, #fffdf9, #f7f0e4);
    box-shadow: 0 12px 34px rgba(0, 0, 0, 0.32);
    color: var(--ink);
    display: grid;
    place-items: center;
    will-change: transform;
  }
  .card__inner {
    padding: 8%;
    width: 100%;
    outline: 1px solid rgba(176, 141, 79, 0.35);
    outline-offset: -6%;
  }
  /* Addressed line, set above the couple like a hand-written envelope */
  .card__to {
    display: grid;
    justify-items: center;
    gap: 0.15em;
    margin: 0 0 6%;
    padding-bottom: 5%;
    border-bottom: 1px solid rgba(176, 141, 79, 0.3);
  }
  .card__to-label {
    font-size: clamp(0.42rem, 1.1vw, 0.56rem);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .card__to-name {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1rem, 3.4vw, 1.6rem);
    line-height: 1.2;
    color: var(--gold);
  }

  .card__eyebrow {
    font-size: clamp(0.5rem, 1.4vw, 0.66rem);
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 0.9rem;
  }
  .card__names {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.6rem, 6.2vw, 3rem);
    line-height: 1.08;
    margin: 0;
  }
  .card__names em { font-style: italic; color: var(--gold); margin-inline: 0.12em; }
  .card__rule {
    width: 42%;
    height: 1px;
    margin: clamp(0.8rem, 2.4vw, 1.4rem) auto;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }
  .card__meta {
    font-size: clamp(0.5rem, 1.5vw, 0.7rem);
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0;
  }
  .card__meta--city { margin-top: 0.5rem; color: var(--gold); }

  /* ── wax seal ──────────────────────────────────────────────── */
  .seal {
    position: absolute;
    top: 46%;
    left: 50%;
    width: clamp(58px, 12%, 88px);
    aspect-ratio: 1;
    margin: 0;
    translate: -50% -50%;
    transform: translateZ(18px);
    transform-style: preserve-3d;
    pointer-events: none;
    filter: drop-shadow(0 3px 5px rgba(60, 40, 14, 0.5));
  }
  .seal__half {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 34% 28%, #c8a05c, #8f6a2e 62%, #6d4f21 100%);
    border-radius: 50%;
    box-shadow: inset 0 -3px 8px rgba(0, 0, 0, 0.4), inset 0 2px 4px rgba(255, 226, 176, 0.35);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: clamp(0.8rem, 2.4vw, 1.15rem);
    letter-spacing: 0.06em;
    color: rgba(255, 246, 227, 0.82);
    will-change: transform;
  }
  /* torn edge down the middle, so the two halves read as one broken disc */
  .seal__half--l { clip-path: polygon(0 0, 54% 0, 46% 26%, 56% 52%, 44% 78%, 52% 100%, 0 100%); }
  .seal__half--r { clip-path: polygon(54% 0, 100% 0, 100% 100%, 52% 100%, 44% 78%, 56% 52%, 46% 26%); }
  .seal__half--l span { transform: translateX(-24%); }
  .seal__half--r span { transform: translateX(26%); }

  .envelope__shadow {
    position: absolute;
    left: 50%;
    bottom: -8%;
    width: 70%;
    height: 26px;
    translate: -50% 0;
    background: radial-gradient(50% 50% at 50% 50%, rgba(0, 0, 0, 0.55), transparent 70%);
    filter: blur(6px);
    will-change: transform, opacity;
  }

  /* ── controls ──────────────────────────────────────────────── */
  .envelope__button {
    position: relative;
    z-index: 1;
    overflow: hidden;
    font: inherit;
    color: inherit;
    background: transparent;
    border: 1px solid var(--gold);
    padding: 1rem 2.6rem;
    font-size: 0.7rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .envelope__button::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.65s var(--ease-out-expo);
  }
  .envelope__button:hover::before { transform: scaleX(1); }
  .envelope__button:hover { color: var(--ink); }
  .envelope__button:disabled { pointer-events: none; opacity: 0.5; }

  .envelope__hint {
    margin: -1.25rem 0 0;
    font-size: 0.58rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(216, 189, 138, 0.5);
  }

  /* Pre-hydration / no-JS fallback so the gate is never a permanent lock */
  .envelope.is-open { opacity: 0; visibility: hidden; pointer-events: none; }

  html.envelope-lock,
  html.envelope-lock body { overflow: hidden; height: 100%; }

  /* ── small screens ─────────────────────────────────────────
     The card's height is a fraction of the envelope's WIDTH (3:2), so
     on a narrow phone there is far less room for the same six lines of
     type. Widen the envelope and tighten every vertical gap so the
     addressed block, the names and the date all still fit inside. */
  @media (max-width: 620px) {
    .envelope { gap: clamp(1.25rem, 3.5vh, 2rem); padding: 1.5rem 0.9rem; }
    .envelope__stage { width: min(560px, 93vw); }

    .card__inner { padding: 6% 5%; outline-offset: -4%; }

    .card__to { margin-bottom: 4%; padding-bottom: 3.5%; gap: 0.1em; }
    .card__to-label { font-size: 0.44rem; letter-spacing: 0.3em; }
    .card__to-name { font-size: clamp(0.95rem, 4.6vw, 1.35rem); }

    .card__eyebrow { font-size: 0.5rem; letter-spacing: 0.3em; margin-bottom: 0.5rem; }
    .card__names { font-size: clamp(1.45rem, 7.4vw, 2.2rem); }
    .card__rule { margin: 0.6rem auto; }
    .card__meta { font-size: 0.5rem; letter-spacing: 0.18em; }
    .card__meta--city { margin-top: 0.3rem; }
  }

  /* Landscape phones and short windows: the object plus the button and
     hint have to share very little height. */
  @media (max-height: 620px) {
    .envelope__stage { width: min(460px, 78vw); }
    .envelope { gap: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .envelope { transition: opacity 0.4s linear, visibility 0.4s; }
    .paper { cursor: pointer; }
  }
</style>

<script>
  import anime from 'animejs/lib/anime.es.js';

  const envelope = document.querySelector<HTMLElement>('[data-envelope]');
  const button = document.querySelector<HTMLButtonElement>('[data-open-invitation]');
  const paper = document.querySelector<HTMLElement>('[data-paper]');
  const flap = document.querySelector<HTMLElement>('[data-flap]');
  const card = document.querySelector<HTMLElement>('[data-card]');
  const shadow = document.querySelector<HTMLElement>('[data-shadow]');
  const hint = document.querySelector<HTMLElement>('[data-hint]');
  const sealHalves = Array.from(document.querySelectorAll<HTMLElement>('.seal__half'));

  if (envelope && button && paper && flap && card) {
    document.documentElement.classList.add('envelope-lock');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ── arrival: the envelope is set down on the table ──────── */
    if (!reduced) {
      anime
        .timeline({ easing: 'cubicBezier(0.16, 1, 0.3, 1)' })
        .add({
          targets: paper,
          translateY: [-90, 0],
          rotateX: [34, 0],
          rotateZ: [-6, 0],
          scale: [0.86, 1],
          opacity: [0, 1],
          duration: 1500,
        }, 200)
        .add({ targets: shadow, opacity: [0, 1], scaleX: [0.55, 1], duration: 900 }, 700)
        .add({
          targets: sealHalves,
          opacity: [0, 1],
          scale: [0.4, 1],
          duration: 900,
          easing: 'spring(1, 78, 11, 0)',
        }, 1100)
        .add({ targets: [button, hint], opacity: [0, 1], translateY: [14, 0], duration: 900 }, 1250);
    }

    /* ── idle: paper breathes, and tilts toward the pointer ──── */
    // Written straight onto the element each frame so it composes with the
    // opening timeline being driven by anime on the same transform.
    const REST_TILT = 13;
    let tiltX = 0, tiltY = 0, targetX = 0, targetY = 0, lift = 0, targetLift = 0;
    let opening = false;
    let raf = 0;

    const tick = (t: number) => {
      tiltX += (targetX - tiltX) * 0.08;
      tiltY += (targetY - tiltY) * 0.08;
      lift += (targetLift - lift) * 0.08;
      const float = Math.sin(t / 1400) * 4;
      const breathe = Math.sin(t / 1900) * 0.9;
      // REST_TILT lays the envelope back like an object on a table, so the
      // flap foreshortens when it peels instead of reading as a flat cut-out
      paper.style.transform =
        `translate3d(0, ${float - lift}px, 0) rotateX(${REST_TILT + tiltX + breathe}deg) rotateY(${tiltY}deg)`;
      if (shadow) {
        const s = 1 - lift / 260 - Math.abs(float) / 220;
        shadow.style.transform = `translate(-50%, 0) scaleX(${s}) scaleY(${s})`;
        shadow.style.opacity = String(0.55 + (1 - s) * 0.4);
      }
      raf = requestAnimationFrame(tick);
    };

    if (!reduced) {
      raf = requestAnimationFrame(tick);
      envelope.addEventListener('pointermove', (e) => {
        if (opening) return;
        const r = paper.getBoundingClientRect();
        targetY = ((e.clientX - (r.left + r.width / 2)) / r.width) * 16;
        targetX = -((e.clientY - (r.top + r.height / 2)) / r.height) * 14;
      });
      envelope.addEventListener('pointerleave', () => { targetX = 0; targetY = 0; });
      paper.addEventListener('pointerenter', () => { targetLift = 26; });
      paper.addEventListener('pointerleave', () => { targetLift = 0; });
    }

    /* ── open: seal cracks, flap peels, card rises and fills ─── */
    const open = () => {
      if (opening) return;
      opening = true;
      button.disabled = true;
      targetX = targetY = targetLift = 0;

      if (reduced) {
        window.dispatchEvent(new CustomEvent('invitation:open'));
        document.documentElement.classList.remove('envelope-lock');
        envelope.classList.add('is-open');
        window.scrollTo(0, 0);
        window.setTimeout(() => envelope.remove(), 600);
        return;
      }

      const tl = anime.timeline({ easing: 'cubicBezier(0.16, 1, 0.3, 1)' });

      // the wax gives: a shudder, then the two halves snap apart and drop
      tl.add({
        targets: paper,
        keyframes: [
          { rotateZ: -1.4, rotateX: REST_TILT, duration: 70, easing: 'linear' },
          { rotateZ: 1.4, duration: 70, easing: 'linear' },
          { rotateZ: 0, duration: 120, easing: 'linear' },
          // straightens up as it is opened and offered to the reader
          { rotateX: 7, duration: 1500, easing: 'cubicBezier(0.16, 1, 0.3, 1)' },
        ],
        // the idle loop owns `transform`; hand it over for the opening
        begin: () => cancelAnimationFrame(raf),
      }, 0);

      tl.add({
        targets: '.seal__half--l',
        translateX: -70, translateY: 130, rotateZ: -46, opacity: [1, 0],
        duration: 900, easing: 'easeInQuad',
      }, 220)
        .add({
          targets: '.seal__half--r',
          translateX: 74, translateY: 150, rotateZ: 52, opacity: [1, 0],
          duration: 950, easing: 'easeInQuad',
        }, 260);

      // the flap resists, then peels all the way back
      tl.add({
        targets: flap,
        keyframes: [
          // resists for a moment, then gives and swings all the way back
          { rotateX: -13, translateZ: 16, duration: 380, easing: 'easeOutQuad' },
          { rotateX: -98, translateZ: 16, duration: 430, easing: 'easeInQuad' },
          // settles just past vertical and drops to the back panel's own
          // depth, so it stays hinged to the paper instead of floating off it
          { rotateX: -152, translateZ: 2, duration: 560, easing: 'easeOutQuad' },
        ],
      }, 380);

      // the whole object settles downward to make room for the raised flap
      tl.add({
        targets: document.querySelector('[data-stage]'),
        translateY: [0, 40],
        duration: 1200,
      }, 380);

      // The card is drawn out of the pocket: it stays in the paper's own
      // plane while the pocket still grips it — only once the bottom edge is
      // clear does it lift toward you and turn to face the reader.
      tl.add({
        targets: card,
        keyframes: [
          { translateY: '-14%', rotateZ: 0.7, translateZ: 6, duration: 420, easing: 'easeInOutQuad' },
          { translateY: '-38%', rotateZ: -0.6, translateZ: 6, duration: 480, easing: 'linear' },
          { translateY: '-52%', rotateZ: 0, translateZ: 8, duration: 420, easing: 'easeOutQuad' },
          // free of the paper, and tipped up to be read
          { translateY: '-56%', translateZ: 118, rotateX: -7, duration: 620, easing: 'easeOutQuad' },
          { rotateX: 0, duration: 420, easing: 'easeInOutQuad' },
        ],
      }, 1500)
        .add({ targets: [button, hint], opacity: 0, translateY: 10, duration: 400 }, 1200)
        .add({ targets: shadow, opacity: 0, duration: 800 }, 1500);

      // envelope body falls away, card grows into the page
      tl.add({
        targets: ['.paper__back', '.paper__pocket', flap],
        opacity: 0,
        translateY: 110,
        duration: 850,
        easing: 'easeInCubic',
      }, 3500)
        .add({
          targets: card,
          scale: [1, 3.4],
          translateY: '-52%',
          opacity: [1, 0],
          duration: 1250,
          easing: 'cubicBezier(0.7, 0, 0.3, 1)',
          begin: () => {
            // hand the page over as the card opens out into it
            window.dispatchEvent(new CustomEvent('invitation:open'));
            document.documentElement.classList.remove('envelope-lock');
            window.scrollTo(0, 0);
          },
        }, 3650)
        .add({ targets: envelope, opacity: [1, 0], duration: 900 }, 3950);

      tl.finished.then(() => envelope.remove());
    };

    button.addEventListener('click', open);
    paper.addEventListener('click', open);
  }
</script>

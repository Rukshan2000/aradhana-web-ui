---
/* The fixed page a printed QR code lands on.

   A card carries its address in ink and can never be reprinted, so it must
   not carry the invitation's address — that one is editable and does change.
   Instead every code points here, at /go/…, and this page asks the API which
   URL the invitation answers on *now*. The button below is wired to whatever
   comes back, so renaming a link in the portal re-aims every code already in
   circulation instead of breaking it. */
const { target, name = null, couple = {} } = Astro.props;
const { bride, groom, date_label: dateLabel, city } = couple;
const names = bride && groom ? `${bride} & ${groom}` : null;
---
<main class="go">
  <div class="go__card">
    <p class="eyebrow">You are invited</p>
    {names && <h1 class="script">{names}</h1>}
    {name && <p class="go__to">for <span>{name}</span></p>}

    <div class="ornament" aria-hidden="true">✦</div>

    {dateLabel && <p class="go__meta">{dateLabel}</p>}
    {city && <p class="go__meta go__meta--city">{city}</p>}

    <!-- href is resolved server-side on every scan, never baked into the QR -->
    <a class="go__button" href={target} data-open-invitation>Open Invitation</a>

    <p class="go__hint">Tap to open your invitation</p>
  </div>
</main>

<style>
  .go {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem var(--gutter);
    background:
      radial-gradient(70% 55% at 50% 22%, rgba(255, 255, 255, 0.9), transparent 70%),
      linear-gradient(180deg, var(--ivory) 0%, var(--ivory-deep) 100%);
  }

  .go__card {
    max-width: 32rem;
    width: 100%;
    text-align: center;
    padding: clamp(2.5rem, 7vw, 4rem) clamp(1.5rem, 5vw, 3.5rem);
    border: 1px solid rgba(176, 141, 79, 0.3);
    background: linear-gradient(180deg, #fffdf8 0%, var(--ivory-deep) 100%);
    box-shadow: 0 26px 60px -30px rgba(95, 74, 40, 0.4);
    animation: rise 1s var(--ease-out-expo) both;
  }

  .go h1 {
    font-size: clamp(2rem, 7vw, 3rem);
    line-height: 1.15;
    margin: 0.4rem 0 0;
  }

  .go__to {
    margin: 0.9rem 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .go__to span {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.35rem;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--gold);
    display: block;
    margin-top: 0.35rem;
  }

  .go .ornament { margin: 1.6rem 0; font-size: 0.7rem; }

  .go__meta {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .go__meta--city { margin-top: 0.45rem; color: var(--gold); }

  .go__button {
    position: relative;
    z-index: 0;
    display: inline-block;
    overflow: hidden;
    margin-top: clamp(1.8rem, 5vw, 2.6rem);
    padding: 1rem 2.8rem;
    border: 1px solid var(--gold);
    font-size: 0.72rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    background: transparent;
    transition: color 0.5s var(--ease-out-expo);
  }
  .go__button::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.65s var(--ease-out-expo);
  }
  .go__button:hover::before,
  .go__button:focus-visible::before { transform: scaleX(1); }
  .go__button:hover,
  .go__button:focus-visible { color: var(--ivory); }

  .go__hint {
    margin: 1.1rem 0 0;
    font-size: 0.58rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(122, 98, 58, 0.62);
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(1.2rem); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .go__card { animation: none; }
  }
</style>

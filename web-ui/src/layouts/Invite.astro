---
/* The whole invitation, addressed to one household of one wedding. Both
   routes render this: `/` with the fallback couple + guest from wedding.json,
   and `/[wedding]/[invitee]` with the pair loaded from portal-api. */
import Base from './Base.astro';
import Envelope from '../components/Envelope.astro';
import EnvelopeModern from '../components/EnvelopeModern.astro';
import EnvelopeNotebook from '../components/EnvelopeNotebook.astro';
import Hero from '../components/Hero.astro';
import HeroModern from '../components/HeroModern.astro';
import HeroNotebook from '../components/HeroNotebook.astro';
import EnvelopeCustom1 from '../components/EnvelopeCustom1.astro';
import HeroCustom1 from '../components/HeroCustom1.astro';
import InvitationCustom1 from '../components/InvitationCustom1.astro';
import Invitation from '../components/Invitation.astro';
import InvitationModern from '../components/InvitationModern.astro';
import InvitationNotebook from '../components/InvitationNotebook.astro';
import Countdown from '../components/Countdown.astro';
import Story from '../components/Story.astro';
import Gallery from '../components/Gallery.astro';
import Details from '../components/Details.astro';
import Rsvp from '../components/Rsvp.astro';
import Wishes from '../components/Wishes.astro';
import Footer from '../components/Footer.astro';
import Butterflies from '../components/Butterflies.astro';
import Music from '../components/Music.astro';
import defaultContent, { couple as defaultCouple, guest as fallbackGuest, rsvp as defaultRsvp } from '../data/wedding.js';

const {
  guest = fallbackGuest,
  couple = defaultCouple,
  content = defaultContent,
  replyBy = defaultRsvp.replyBy,
  weddingSlug,
  openRsvp = false,
  rsvpClosed = false,
  wishes = [],
} = Astro.props;

const title = `${couple.bride} & ${couple.groom} — ${couple.dateLabel}`;
const description = guest.slug
  ? `${guest.name}, you are invited to celebrate the wedding of ${couple.bride} and ${couple.groom} in ${couple.city}.`
  : `Join ${couple.bride} and ${couple.groom} in ${couple.city} as they celebrate their wedding. Ceremony details, schedule, gallery, and RSVP.`;
/* Each template supplies its own gate, hero and invitation note; the
   sections below those are shared and skinned by CSS
   (src/styles/template-*.css). An unknown id falls back to classic. */
const TEMPLATES = {
  classic: { Gate: Envelope, Top: Hero, Note: Invitation, butterflies: true },
  modern: { Gate: EnvelopeModern, Top: HeroModern, Note: InvitationModern, butterflies: false },
  notebook: { Gate: EnvelopeNotebook, Top: HeroNotebook, Note: InvitationNotebook, butterflies: false },
  custom1: { Gate: EnvelopeCustom1, Top: HeroCustom1, Note: InvitationCustom1, butterflies: false },
};
const templateId = couple.templateId || 'classic';
const { Gate, Top, Note, butterflies } = TEMPLATES[templateId] || TEMPLATES.classic;
/* Per-account feature flags from the portal; only an explicit false hides a section. */
const on = (feature) => couple.features?.[feature] !== false;
---
<Base title={title} description={description} wedding={weddingSlug} invitee={guest.slug} data-template={templateId}>
  <Gate guest={guest} couple={couple} openInvite={openRsvp} />
  <Top couple={couple} hero={content.hero} heading={content.headings.hero}
    guest={guest} details={content.details} openInvite={openRsvp} />
  <Note guest={guest} couple={couple} openInvite={openRsvp} heading={content.headings.invitation} />
  {on('countdown') && <Countdown couple={couple} heading={content.headings.countdown} />}
  {on('story') && <Story story={content.story} heading={content.headings.story} weddingYear={new Date(couple.date).getFullYear()} />}
  {on('gallery') && <Gallery gallery={content.gallery} galleryPool={content.galleryPool} heading={content.headings.gallery} />}
  <Details details={content.details} schedule={on('schedule') ? content.schedule : []} venuePhoto={content.venuePhoto}
    couple={couple} heading={content.headings.details} scheduleHeading={content.headings.schedule} />
  <Rsvp guest={guest} couple={couple} replyBy={replyBy} weddingSlug={weddingSlug} openRsvp={openRsvp}
    closed={rsvpClosed} heading={content.headings.rsvp} />
  {on('wishes') && <Wishes wishes={wishes} samples={couple.sampleWishes !== false} />}
  <Footer couple={couple} on={on} />
  {butterflies && <Butterflies />}
  {on('music') && <Music music={content.music} />}
</Base>

---
import '../styles/global.css';
/* The "modern" template's skin. Entirely scoped to body[data-template="modern"],
   so loading it here never affects the classic design. */
import '../styles/template-modern.css';
/* Likewise the "notebook" template, scoped to body[data-template="notebook"]. */
import '../styles/template-notebook.css';
/* `wedding` / `invitee` are stamped on <body> so the client-side tracker
   knows which invitation it is reporting on; a page without them (the 404,
   the expired page) simply does not track. */
const { title, description, wedding = '', invitee = '', 'data-template': templateId = 'classic' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Jost:wght@200;300;400&family=Alex+Brush&family=Caveat:wght@400;600;700&family=Kalam:wght@300;400&display=swap"
    />
  </head>
  <body data-wedding={wedding} data-invitee={invitee} data-template={templateId}>
    <div class="progress" aria-hidden="true"><span data-progress></span></div>
    <slot />
    <script>
      import '../scripts/motion.js';
      import '../scripts/track.js';
    </script>
    <style>
      .progress {
        position: fixed;
        inset: 0 0 auto 0;
        height: 2px;
        z-index: 90;
        pointer-events: none;
      }
      .progress span {
        display: block;
        height: 100%;
        background: linear-gradient(90deg, var(--gold-light), var(--gold));
        transform: scaleX(0);
        transform-origin: 0 50%;
      }
    </style>
  </body>
</html>

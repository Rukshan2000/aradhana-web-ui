# ── Database (reached through the SSH tunnel; see scripts/tunnel.sh) ────────────
# The tunnel forwards local 5433 -> server 127.0.0.1:5432
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=kwings-wedding-invitation
DB_USER=kwings_wedding
DB_PASSWORD=change-me

# ── MinIO / S3 (talking directly to the server's MinIO, no tunnel needed) ──────
S3_ENDPOINT=https://minio.kwingsmedia.com
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kwings-wedding-invitation
# Public URL used to build image links returned to clients:
S3_PUBLIC_URL=https://minio.kwingsmedia.com/kwings-wedding-invitation

# ── App ────────────────────────────────────────────────────────────────────────
PORT=4000

# ── Tunnel target ──────────────────────────────────────────────────────────────
SSH_HOST=root@164.68.97.187

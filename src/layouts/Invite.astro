---
/* The whole invitation, addressed to one household. Both routes render
   this: `/` with the fallback guest from wedding.json, and `/[guest]`
   with the record from src/data/guests/<slug>.json. */
import Base from './Base.astro';
import Envelope from '../components/Envelope.astro';
import Hero from '../components/Hero.astro';
import Invitation from '../components/Invitation.astro';
import Countdown from '../components/Countdown.astro';
import Story from '../components/Story.astro';
import Gallery from '../components/Gallery.astro';
import Details from '../components/Details.astro';
import Rsvp from '../components/Rsvp.astro';
import Footer from '../components/Footer.astro';
import Butterflies from '../components/Butterflies.astro';
import Music from '../components/Music.astro';
import { couple, guest as fallbackGuest } from '../data/wedding.js';

const { guest = fallbackGuest } = Astro.props;

const title = `${couple.bride} & ${couple.groom} — ${couple.dateLabel}`;
const description = guest.slug
  ? `${guest.name}, you are invited to celebrate the wedding of ${couple.bride} and ${couple.groom} in ${couple.city}.`
  : `Join ${couple.bride} and ${couple.groom} in ${couple.city} as they celebrate their wedding. Ceremony details, schedule, gallery, and RSVP.`;
---
<Base title={title} description={description}>
  <Envelope guest={guest} />
  <Hero />
  <Invitation guest={guest} />
  <Countdown />
  <Story />
  <Gallery />
  <Details />
  <Rsvp guest={guest} />
  <Footer />
  <Butterflies />
  <Music />
</Base>

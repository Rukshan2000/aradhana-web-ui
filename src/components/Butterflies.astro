---
/* A site-wide flight of butterflies. Fixed above the page, under the
   envelope gate, never interactive. All motion is transform-only and
   driven by one rAF loop in this component's script. */
const COUNT = 4;
const butterflies = Array.from({ length: COUNT }, (_, i) => i);
---
<div class="flight" data-flight aria-hidden="true">
  {butterflies.map(() => (
    <span class="fly" data-fly>
      <span class="fly__body">
        <span class="butterfly">
          <span class="wing">
            <span class="bit"></span>
            <span class="bit"></span>
          </span>
          <span class="wing">
            <span class="bit"></span>
            <span class="bit"></span>
          </span>
        </span>
      </span>
    </span>
  ))}
</div>

<style>
  .flight {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    overflow: hidden;
  }

  /* Each butterfly is built in real 3D: the wings are rotated planes,
     so a flap turns them edge-on instead of squashing a flat shape. */
  .fly {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    will-change: transform;
  }

  /* Perspective must sit on the butterfly's DIRECT parent, or the wing
     planes flatten and the flap reads as a squash. */
  .fly__body {
    display: block;
    perspective: 800px;
    transform-origin: 0 0;
  }

  .butterfly {
    position: relative;
    display: block;
    width: 30px;
    transform-style: preserve-3d;
    transform: rotateX(50deg) rotateY(20deg) rotateZ(-50deg);
    animation: hover var(--flap, 250ms) cubic-bezier(0.48, 0.01, 0.54, 1) infinite alternate;
  }

  /* The body — a long thin ellipse stood on edge between the wings */
  .butterfly::before {
    content: "";
    position: absolute;
    top: -15px;
    left: 50%;
    z-index: 2;
    display: block;
    width: 20px;
    height: 110px;
    margin-left: -10px;
    border-radius: 50%;
    background: var(--body, #4a3c28);
    transform: rotateY(100deg);
    outline: 1px solid transparent;
  }

  .wing {
    position: absolute;
    top: 0;
    display: block;
    opacity: 0.75;
    outline: 1px solid transparent;
  }
  .wing:first-child {
    left: 0;
    z-index: 3;
    width: 1px;
    height: 1px;
    transform: rotateY(-20deg);
    transform-origin: 700% 50%;
    animation: leftflap var(--flap, 250ms) cubic-bezier(0.48, 0.01, 0.54, 1) infinite alternate;
  }
  .wing:last-child {
    right: 0;
    z-index: 1;
    transform: rotateY(200deg);
    animation: rightflap var(--flap, 250ms) cubic-bezier(0.48, 0.01, 0.54, 1) infinite alternate;
  }

  .bit, .bit::after {
    position: absolute;
    top: 0;
    right: 0;
    overflow: hidden;
    border-radius: 50%;
    transform-origin: 100% 50%;
  }
  .bit { background: var(--wing, #d8bd8a); }
  .bit::after { background: var(--wing-lower, #b08d4f); }

  .bit:first-child {
    top: 15px;
    width: 130px;
    height: 70px;
    transform: rotateZ(40deg);
  }
  .bit:first-child::after {
    content: "";
    display: inline-block;
    top: 5px;
    left: -30px;
    width: 100px;
    height: 60px;
  }

  .bit:last-child {
    width: 100px;
    height: 55px;
    transform: rotateZ(-40deg);
  }
  .bit:last-child::after {
    content: "";
    display: inline-block;
    z-index: 1;
    top: 5px;
    left: -24px;
    width: 60px;
    height: 45px;
  }

  @keyframes hover {
    0%   { transform: rotateX(50deg) rotateY(20deg) rotateZ(-50deg) translateZ(0); }
    100% { transform: rotateX(50deg) rotateY(20deg) rotateZ(-50deg) translateZ(-3px); }
  }
  @keyframes leftflap {
    0%   { transform: rotateY(-20deg); }
    100% { transform: rotateY(90deg); }
  }
  @keyframes rightflap {
    0%   { transform: rotateY(200deg); }
    100% { transform: rotateY(90deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .flight { display: none; }
  }
</style>

<script>
  const initFlight = () => {
    const layer = document.querySelector('[data-flight]') as HTMLElement | null;
    if (!layer || layer.dataset.ready === '1') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    layer.dataset.ready = '1';

    const all = [...layer.querySelectorAll('[data-fly]')] as HTMLElement[];
    /* Fewer wings on small screens — they crowd a phone and cost more
       per painted pixel there than they are worth. */
    const keep = window.matchMedia('(max-width: 700px)').matches ? 2 : all.length;
    all.slice(keep).forEach((el) => el.remove());
    const flies = all.slice(0, keep);

    const rand = (min: number, max: number) => min + Math.random() * (max - min);

    /* Wing pairs: an upper colour and a deeper lower wing, so each
       butterfly reads as one species rather than a flat cutout. */
    const WINGS = [
      { main: '#d8bd8a', lower: '#b08d4f', body: '#5b4826' }, // gold
      { main: '#e8d5cd', lower: '#c9a396', body: '#6b4f46' }, // blush
      { main: '#f2e6cf', lower: '#d8bd8a', body: '#6a5734' }, // cream
      { main: '#c8b7d4', lower: '#9a86ad', body: '#4d4059' }, // lilac
      { main: '#a9bda6', lower: '#8a9a83', body: '#44513f' }, // sage
      { main: '#e6b98f', lower: '#c4885a', body: '#6d452a' }, // apricot
      { main: '#bcd0d8', lower: '#8fb0bc', body: '#3f5661' }, // dusk blue
    ];

    type Fly = {
      el: HTMLElement;
      x: number; y: number;
      dir: 1 | -1;      // +1 flies left→right, -1 flies right→left
      speed: number;    // px per frame-ish, horizontal
      scale: number;
      drift: number;    // how far it bobs vertically
      bob: number;      // vertical wave speed
      phase: number;
    };

    const MARGIN = 90;

    /* Every crossing is a fresh butterfly: new side, height, size and
       species. They only ever traverse — nothing circles mid-screen. */
    const respawn = (f: Fly, firstRun = false) => {
      const scale = rand(0.1, 0.34);
      const t = (scale - 0.1) / 0.24;
      const wing = WINGS[Math.floor(Math.random() * WINGS.length)];

      f.el.style.setProperty('--wing', wing.main);
      f.el.style.setProperty('--wing-lower', wing.lower);
      f.el.style.setProperty('--body', wing.body);
      f.el.style.setProperty('--flap', `${rand(190 + t * 90, 260 + t * 140).toFixed(0)}ms`);
      f.el.style.opacity = (0.45 + t * 0.45).toFixed(2);

      f.dir = Math.random() < 0.5 ? 1 : -1;
      f.scale = scale;
      // Small ones cross quickly, big ones sail
      f.speed = rand(0.9, 2.3) * (1.3 - t * 0.5);
      f.drift = rand(18, 70);
      f.bob = rand(0.0012, 0.0032);
      f.phase = rand(0, Math.PI * 2);
      f.y = rand(0.05, 0.95) * window.innerHeight;

      const w = window.innerWidth;
      f.x = f.dir === 1 ? -MARGIN : w + MARGIN;
      // On the very first frame, scatter them mid-crossing so the page
      // doesn't open with every butterfly queued at the same edge.
      if (firstRun) f.x = rand(-MARGIN, w + MARGIN);
    };

    const swarm: Fly[] = flies.map((el) => {
      const f: Fly = {
        el,
        x: 0, y: 0,
        dir: 1,
        speed: 1,
        scale: 0.2,
        drift: 30,
        bob: 0.002,
        phase: 0,
      };
      respawn(f, true);
      return f;
    });

    /* Scroll pushes the flight the opposite way, as if the page were
       sliding past them; the kick decays back to level crossing. */
    let lastScroll = window.scrollY;
    let kick = 0;
    window.addEventListener(
      'scroll',
      () => {
        const now = window.scrollY;
        kick += (now - lastScroll) * 0.06;
        kick = Math.max(-16, Math.min(16, kick));
        lastScroll = now;
      },
      { passive: true }
    );

    let raf = 0;
    let last = performance.now();

    const frame = (now: number) => {
      const dt = Math.min(48, now - last) / 16.7; // in ~frames
      last = now;
      kick *= 0.94;

      const w = window.innerWidth;
      const h = window.innerHeight;

      swarm.forEach((f) => {
        f.phase += dt * 16.7 * f.bob;

        f.x += f.speed * f.dir * dt;
        // A gentle sine bob is the only vertical motion — the path stays
        // a crossing, never a loop.
        f.y += Math.sin(f.phase) * f.drift * 0.02 * dt - kick * 0.05 * dt;

        if (f.y < -MARGIN) f.y = -MARGIN;
        if (f.y > h + MARGIN) f.y = h + MARGIN;

        // Off the far edge → come back in from a side, brand new
        if ((f.dir === 1 && f.x > w + MARGIN) || (f.dir === -1 && f.x < -MARGIN)) {
          respawn(f);
          return;
        }

        // Nose follows the bob; flip the whole butterfly when heading left
        const tilt = Math.sin(f.phase) * 8;
        f.el.style.transform =
          `translate3d(${f.x.toFixed(1)}px, ${f.y.toFixed(1)}px, 0) ` +
          `scaleX(${f.dir}) rotate(${tilt.toFixed(1)}deg) scale(${f.scale.toFixed(3)})`;
      });

      raf = requestAnimationFrame(frame);
    };

    const start = () => {
      if (raf) return;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    };
    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };

    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    start();
  };

  initFlight();
  document.addEventListener('astro:page-load', initFlight);
</script>

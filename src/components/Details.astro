---
import { details, schedule, venuePhoto } from '../data/wedding.js';
---
<section class="section details" id="details">
  <div class="wrap">
    <header class="details__head">
      <p class="eyebrow" data-reveal>The day</p>
      <h2 data-split>When and where</h2>
    </header>

    <div class="cards" data-stagger="160">
      {details.map((d, i) => (
        <article class="card" data-reveal={i % 2 ? 'right' : 'left'} data-tilt>
          <div class="card__inner">
            <span class="card__corner card__corner--tl" aria-hidden="true"></span>
            <span class="card__corner card__corner--br" aria-hidden="true"></span>
            <p class="card__label">{d.label}</p>
            <p class="card__time script">{d.time}</p>
            <h3>{d.venue}</h3>
            <p class="card__address">{d.address}</p>
            <p class="card__note">{d.note}</p>
          </div>
        </article>
      ))}
    </div>
  </div>

  <figure class="banner" data-curtain data-wipe="left">
    <span class="banner__layer" data-parallax="0.3" data-scrub="zoom">
      <img src={venuePhoto.src} alt={venuePhoto.alt} loading="lazy" decoding="async" />
    </span>
  </figure>

  <div class="wrap narrow">
    <h3 class="schedule__title" data-reveal>Order of the evening</h3>
    <div class="schedule__wrap" data-timeline>
      <span class="schedule__rail" aria-hidden="true"><i class="schedule__fill" data-rail-fill></i></span>
      <ol class="schedule">
        {schedule.map((row) => (
          <li class="schedule__row" data-row>
            <span class="schedule__marker" aria-hidden="true"></span>
            <span class="schedule__time">{row.time}</span>
            <span class="schedule__dots" aria-hidden="true"></span>
            <span class="schedule__event">{row.event}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .details { background: var(--ivory); padding-inline: 0; }
  .details__head { text-align: center; margin-bottom: clamp(2.5rem, 7vh, 4.5rem); }
  .details__head h2 { font-size: clamp(2rem, 5vw, 3.4rem); }
  .details .wrap { padding-inline: var(--gutter); }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .card { perspective: 900px; }
  .card__inner {
    position: relative;
    border: var(--rule);
    padding: clamp(1.75rem, 4vw, 2.75rem);
    background: var(--ivory);
    text-align: center;
    transform-style: preserve-3d;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s ease;
  }
  .card[data-tilting] .card__inner { transition: box-shadow 0.5s ease; }
  .card:hover .card__inner { box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.35); }

  /* Gold brackets that draw themselves out from the corners on hover */
  .card__corner {
    position: absolute;
    width: 26px;
    height: 26px;
    border: 0 solid var(--gold);
    opacity: 0;
    transition: opacity 0.5s ease, width 0.5s ease, height 0.5s ease;
  }
  .card__corner--tl {
    top: -1px;
    left: -1px;
    border-top-width: 1px;
    border-left-width: 1px;
  }
  .card__corner--br {
    right: -1px;
    bottom: -1px;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }
  .card:hover .card__corner { opacity: 1; width: 46px; height: 46px; }
  .card__label {
    font-size: 0.65rem;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.2rem;
  }
  .card__time { font-size: 1.5rem; margin-bottom: 0.75rem; }
  .card h3 { font-size: clamp(1.5rem, 2.6vw, 2rem); margin-bottom: 0.5rem; }
  .card__address { color: var(--ink-soft); margin-bottom: 1.4rem; }
  .card__note {
    font-size: 0.82rem;
    color: var(--ink-soft);
    border-top: var(--rule);
    padding-top: 1.2rem;
    margin: 0;
  }

  .banner {
    position: relative;
    margin: clamp(4rem, 10vh, 7rem) 0;
    height: clamp(280px, 55vh, 620px);
    overflow: hidden;
  }
  .banner__layer { position: absolute; left: 0; right: 0; top: -15%; height: 130%; will-change: transform; }
  .banner img { width: 100%; height: 100%; object-fit: cover; }

  .schedule__title {
    text-align: center;
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    margin-bottom: 2.5rem;
  }
  .schedule__wrap { position: relative; }
  .schedule {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.9rem;
    display: grid;
    gap: 1.4rem;
  }
  /* Rail that fills as the list scrolls through the viewport */
  .schedule__rail {
    position: absolute;
    left: 4px;
    top: 0.55em;
    bottom: 0.55em;
    width: 1px;
    background: var(--gold-light);
    opacity: 0.45;
  }
  .schedule__fill {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--gold);
    transform: scaleY(var(--fill, 0));
    transform-origin: top;
    will-change: transform;
  }
  .schedule__row {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    opacity: 0.35;
    transform: translate3d(0, 12px, 0);
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .schedule__row.is-lit { opacity: 1; transform: none; }
  .schedule__marker {
    position: absolute;
    left: calc(-1.9rem + 1px);
    top: 0.45em;
    width: 7px;
    height: 7px;
    border: 1px solid var(--gold);
    border-radius: 50%;
    background: var(--ivory);
    transform: scale(0.6);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), background 0.5s ease;
  }
  .schedule__row.is-lit .schedule__marker { transform: scale(1); background: var(--gold); }
  .schedule__time {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    text-transform: uppercase;
    color: var(--gold);
    min-width: 6.5em;
  }
  .schedule__dots {
    flex: 1;
    height: 1px;
    background-image: linear-gradient(90deg, var(--gold-light) 40%, transparent 40%);
    background-size: 6px 1px;
    opacity: 0.7;
  }
  .schedule__event { font-family: var(--font-display); font-size: 1.25rem; }

  @media (prefers-reduced-motion: reduce) {
    .card__inner, .schedule__row, .schedule__marker { transition-duration: 0.01ms; }
    .schedule__row { opacity: 1; transform: none; }
    .schedule__fill { transform: scaleY(1); }
  }
</style>

<script>
  const initDetails = () => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ── Cards follow the pointer with a slight 3D tilt ──────────── */
    document.querySelectorAll('[data-tilt]').forEach((card) => {
      if (card.dataset.ready === '1') return;
      card.dataset.ready = '1';
      const inner = card.querySelector('.card__inner');
      if (!inner || reduced) return;

      let frame = 0;
      const move = (e) => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const r = card.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          inner.style.transform =
            `rotateX(${(-y * 6).toFixed(2)}deg) rotateY(${(x * 6).toFixed(2)}deg) translateZ(6px)`;
        });
      };

      card.addEventListener('pointermove', move);
      card.addEventListener('pointerenter', () => card.setAttribute('data-tilting', ''));
      card.addEventListener('pointerleave', () => {
        card.removeAttribute('data-tilting');
        inner.style.transform = '';
      });
    });

    /* ── Schedule rail fills with scroll; rows light as they pass ── */
    const list = document.querySelector('[data-timeline]');
    if (!list || list.dataset.ready === '1') return;
    list.dataset.ready = '1';

    const fill = list.querySelector('[data-rail-fill]');
    const rows = [...list.querySelectorAll('[data-row]')];

    if (reduced) {
      rows.forEach((row) => row.classList.add('is-lit'));
      return;
    }

    let inView = false;
    let ticking = false;

    const update = () => {
      ticking = false;
      const r = list.getBoundingClientRect();
      const line = window.innerHeight * 0.72;
      const progress = Math.min(1, Math.max(0, (line - r.top) / r.height));
      if (fill) fill.style.setProperty('--fill', progress.toFixed(3));
      rows.forEach((row) => {
        const rr = row.getBoundingClientRect();
        row.classList.toggle('is-lit', rr.top < line);
      });
    };

    const onScroll = () => {
      if (!inView || ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);

    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        if (inView) onScroll();
      },
      { rootMargin: '20% 0px' }
    ).observe(list);

    update();
  };

  initDetails();
  document.addEventListener('astro:page-load', initDetails);
</script>

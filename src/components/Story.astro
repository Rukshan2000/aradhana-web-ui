---
import { story } from '../data/wedding.js';
---
<section class="section story" id="story">
  <div class="wrap">
    <header class="story__head">
      <p class="eyebrow" data-reveal>Our story</p>
      <h2 data-split>Seven years, told briefly</h2>
    </header>

    <div class="story__card" data-story-carousel>
      <figure class="story__media">
        {story.map((chapter, i) => (
          <img
            src={chapter.photo}
            alt={chapter.alt}
            class={`story__img ${i === 0 ? 'is-active' : ''}`}
            data-slide-img
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        ))}
      </figure>

      <div class="story__body">
        {story.map((chapter, i) => (
          <div class={`story__text ${i === 0 ? 'is-active' : ''}`} data-slide-text>
            <p class="story__year">{chapter.year}</p>
            <h3>{chapter.title}</h3>
            <p class="story__copy">{chapter.text}</p>
          </div>
        ))}

        <div class="story__dots" role="tablist" aria-label="Our story chapters">
          {story.map((chapter, i) => (
            <button
              type="button"
              class={`story__dot ${i === 0 ? 'is-active' : ''}`}
              data-slide-dot
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={`${chapter.year} — ${chapter.title}`}
            ></button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .story { background: var(--ivory); padding-block: clamp(3.5rem, 8vh, 6rem); }
  .story__head { text-align: center; margin-bottom: clamp(1.75rem, 4vh, 2.75rem); }
  .story__head h2 { font-size: clamp(1.9rem, 4vw, 2.9rem); }

  .story__card {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    align-items: stretch;
    gap: clamp(1.5rem, 4vw, 3rem);
    max-width: 920px;
    margin-inline: auto;
  }

  .story__media {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    max-height: 380px;
    background: var(--ivory-deep);
    overflow: hidden;
  }
  .story__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 0.9s ease, transform 1.6s ease;
  }
  .story__img.is-active { opacity: 1; transform: scale(1); }

  .story__body {
    position: relative;
    display: grid;
    align-content: center;
  }
  .story__text {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    pointer-events: none;
  }
  .story__text.is-active { opacity: 1; transform: none; pointer-events: auto; }

  .story__year {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--gold);
    margin: 0 0 0.3rem;
  }
  .story__body h3 { font-size: clamp(1.35rem, 2.4vw, 1.9rem); margin: 0 0 0.6rem; }
  .story__copy { color: var(--ink-soft); max-width: 34em; margin: 0; }

  .story__dots { grid-row: 2; display: flex; gap: 0.6rem; margin-top: 1.4rem; }
  .story__dot {
    width: 30px;
    height: 2px;
    padding: 0;
    border: 0;
    cursor: pointer;
    background: color-mix(in srgb, var(--ink-soft) 35%, transparent);
    transition: background 0.4s ease;
  }
  .story__dot.is-active { background: var(--gold); }

  @media (max-width: 780px) {
    .story__card { grid-template-columns: 1fr; gap: 1.25rem; }
    .story__media { aspect-ratio: 3 / 2; max-height: 260px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .story__img, .story__text { transition-duration: 0.01ms; }
  }
</style>

<script>
  const init = () => {
    const root = document.querySelector('[data-story-carousel]');
    if (!root || root.dataset.ready === '1') return;
    root.dataset.ready = '1';

    const imgs = [...root.querySelectorAll('[data-slide-img]')];
    const texts = [...root.querySelectorAll('[data-slide-text]')];
    const dots = [...root.querySelectorAll('[data-slide-dot]')];
    if (imgs.length < 2) return;

    let index = 0;
    let visible = true;

    const show = (next) => {
      index = (next + imgs.length) % imgs.length;
      imgs.forEach((el, i) => el.classList.toggle('is-active', i === index));
      texts.forEach((el, i) => el.classList.toggle('is-active', i === index));
      dots.forEach((el, i) => {
        el.classList.toggle('is-active', i === index);
        el.setAttribute('aria-selected', i === index ? 'true' : 'false');
      });
    };

    let tick = setInterval(() => {
      if (visible && !document.hidden) show(index + 1);
    }, 5000);

    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        show(i);
        clearInterval(tick);
        tick = setInterval(() => {
          if (visible && !document.hidden) show(index + 1);
        }, 5000);
      })
    );

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => { visible = entry.isIntersecting; },
        { threshold: 0 }
      ).observe(root);
    }
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>

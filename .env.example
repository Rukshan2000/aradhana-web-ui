# Deployment environment for docker-compose.yml.
# Copy to .env on the server and fill in. Never commit the real .env.

# ── Host Postgres (already running on 164.68.97.187, db is migrated) ──────────
DB_NAME=kwings-wedding-invitation
DB_USER=kwings_wedding
DB_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────────────────────
# The API refuses to start without this. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# ── Origins ──────────────────────────────────────────────────────────────────
# Locks the API's CORS to the portal. Without it the API reflects any origin.
PORTAL_ORIGIN=https://guestbookportal.kwingsmedia.com

# Baked into the portal bundle at build time (rebuild after changing).
VITE_API_BASE=https://guestbookapi.kwingsmedia.com
VITE_SITE_BASE=https://guestbook.kwingsmedia.com

# ── MinIO (already running on the host) ───────────────────────────────────────
S3_ENDPOINT=https://minio.kwingsmedia.com
S3_REGION=us-east-1
S3_BUCKET=kwings-wedding-invitation
S3_PUBLIC_URL=https://minio.kwingsmedia.com/kwings-wedding-invitation
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Email (sign-in codes + password resets) ───────────────────────────────────
# Without these the API still runs, but /login/code and /password/forgot
# return 503. Gmail needs an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Guest Book
SMTP_FROM_EMAIL=
